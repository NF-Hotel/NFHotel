# Builds the database API (ADR-0004) with the same SDK version as global.json.
# Base images pinned by digest (MIL-022 task 4); Dependabot proposes the next ones.
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build

# Working folder in the build image.
WORKDIR /source

# Copies the SDK settings, the code rules and the projects under src.
COPY global.json .editorconfig ./
COPY src/ ./src/

# Restores the NuGet packages, builds and publishes the API.
RUN dotnet publish src/NFHotel.Api/NFHotel.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

# The final image holds ASP.NET Core to run the API.
FROM mcr.microsoft.com/dotnet/aspnet:10.0.13@sha256:8af87eba5e7cdafb1514d7388be287365da97c132509e84dfe252ffd552398ca AS final

WORKDIR /app

COPY --from=build /app/publish .

# The API listens on port 8080 inside the container and publishes nothing.
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

# Runs as the built-in user without root rights.
USER app

ENTRYPOINT ["dotnet", "NFHotel.Api.dll"]
