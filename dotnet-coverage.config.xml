<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for dotnet-coverage in CI: measure the NFHotel assemblies, not the tests or generated migrations -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]NFHotel\.[^\\/]*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*\.Tests\.dll$</ModulePath>
        <ModulePath>.*[\\/]NFHotel\.TestSupport\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]Migrations[\\/].*\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
