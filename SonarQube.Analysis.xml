<?xml version="1.0" encoding="utf-8"?>
<!-- Settings of the SonarQube Cloud analysis in the build job of NF Hotel CI (ADR-0033). The token is not here:
     the scanner reads it from the environment variable SONAR_TOKEN. -->
<SonarQubeAnalysisProperties xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">
  <Property Name="sonar.host.url">https://sonarcloud.io</Property>
  <!-- Visual Studio XML from dotnet-coverage; the C# analyzer does not read Cobertura -->
  <Property Name="sonar.cs.vscoveragexml.reportsPaths">TestResults/coverage.xml</Property>
  <Property Name="sonar.cs.vstest.reportsPaths">TestResults/**/*.trx</Property>
  <!-- The migrations are generated code, as in dotnet-coverage.config.xml -->
  <!-- The operations code under ops/ is tested in Ops CI, not by this .NET job: the scan exporter's
       coverage is measured and held at 80 % or more by ops/tests/test-scan-exporter.sh (MIL-053) -->
  <!-- The design-time HotelDbContextFactory is used only by dotnet ef, and scripts/*.ps1 are the developer launchers
       for Windows (dev-up.ps1, MIL-054; dev-f5.ps1, MIL-057), which have no test runner in CI -->
  <Property Name="sonar.coverage.exclusions">**/Migrations/**,ops/**,scripts/*.ps1,**/HotelDbContextFactory.cs</Property>
  <!-- NeighbourhoodPlaces is content, not code: eleven records of the same shape, which the copy-paste
       detector reads as copies of one another -->
  <Property Name="sonar.cpd.exclusions">**/NeighbourhoodPlaces.cs</Property>
  <!-- docker:S6471 (an image that runs as root) on the proxy only. Its Dockerfile (ADR-0040) keeps the user of
       the pinned nginx image: the master process starts as root to bind 80 and 443 and to read privkey.pem,
       which is 0600 and owned by the user of the checkout, and the workers run as nginx. The compose file
       drops every capability but five, mounts the root file system read-only and sets no-new-privileges
       (MIL-023 task 2, CIS-001). The upstream image ran the same way before it had a Dockerfile that the
       analysis could read; a master without root is a change of the proxy and its certificate, not of
       this file. -->
  <!-- docker:S6471 on the socket proxy of Alloy too (ADR-0040 decision 5, MIL-065). Its Dockerfile keeps the
       user of the pinned tecnativa/docker-socket-proxy image: HAProxy runs as root because root owns the Docker
       socket, which it reads without a capability. The compose file drops every capability, mounts the root file
       system and the socket read-only, sets no-new-privileges, allows only read calls of the Docker API and puts
       the proxy on an internal network with no route out (MIL-023). The upstream image ran the same way before
       it had a Dockerfile that the analysis could read. -->
  <Property Name="sonar.issue.ignore.multicriteria">nginxroot,socketproxyroot</Property>
  <Property Name="sonar.issue.ignore.multicriteria.nginxroot.ruleKey">docker:S6471</Property>
  <Property Name="sonar.issue.ignore.multicriteria.nginxroot.resourceKey">ops/deploy/nginx/Dockerfile</Property>
  <Property Name="sonar.issue.ignore.multicriteria.socketproxyroot.ruleKey">docker:S6471</Property>
  <Property Name="sonar.issue.ignore.multicriteria.socketproxyroot.resourceKey">ops/deploy/alloy/socket-proxy/Dockerfile</Property>
</SonarQubeAnalysisProperties>
