# The Git history and the editor settings do not belong in the build context.
.git
.vs
.vscode

# Local build output must not be used in the build of the container.
**/bin
**/obj

# Local environment files and development settings must not be copied.
**/.env
**/.env.*
**/*.env
**/appsettings.Development.json

# The mobile project, the tests and the prototypes are not used by this web application.
tests
prototypes
