# Settings for the benchmark service. Copy to benchmark.env (git-ignored).
# Values are plain text: do not quote them. No secret is needed.

# Name of the Docker network shared with the nginx service.
NFHOTEL_PROXY_NETWORK=nfhotel-proxy
# Name of the Docker network shared with Ollama.
NFHOTEL_LLM_NETWORK=nfhotel-llm
# Source repository and the commit it is built from (upgrade by changing the commit).
BENCHMARK_REPO=https://github.com/NF-Hotel/notebook-benchmark.git
BENCHMARK_REF=bc6d5ff04ba571e184a0a8bc29ad4b6d4e6255a4
