# Settings for the data analysis service. Copy to data-analysis.env (git-ignored).
# Values are plain text: do not quote them. Never commit data-analysis.env.
# The names are those of the README of notebook-data-analysis.
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
# Token that the NFHotel API must send to this service. The NFHotel API gets the same value as
# MarketAnalysisService__Token in nfhotel-api.env. Create with: openssl rand -hex 32
API_TOKEN=<token-of-at-least-32-characters>
# Production needs explicit origins; the browser never calls this service, so none is allowed.
CORS_ALLOWED_ORIGINS=
# The Ollama of NFHotel on the network nfhotel-llm (deploy/ollama). The model is the default AI model of the
# market analysis (ADR-0014); scripts/deploy-services.sh writes it when this service is added to the script.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
AI_TIMEOUT_SECONDS=240
# The market data: the JSON API of the analysis service, or CSV files in example mode.
DATA_SOURCE=api
MARKET_DATA_API_URL=http://market-analysis-api:8000
MARKET_DATA_API_TOKEN=
# Names of the Docker networks that NFHotel makes.
NFHOTEL_API_NETWORK=nfhotel-api
NFHOTEL_LLM_NETWORK=nfhotel-llm
# Source repository and the commit it is built from (a commit that has a Dockerfile).
DATA_ANALYSIS_REPO=https://github.com/NF-Hotel/notebook-data-analysis.git
DATA_ANALYSIS_REF=
