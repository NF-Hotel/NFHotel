# Settings for the PostgreSQL service. Copy to postgres.env (git-ignored).
# Values are plain text: do not quote them. Never commit postgres.env.

POSTGRES_USER=nfhotel
# Choose a long random password without ; or quotes: openssl rand -hex 24
# The web service reads user, password and database from this file.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nfhotel

# Name of the internal Docker network shared with the web service only.
NFHOTEL_DB_NETWORK=nfhotel-db
