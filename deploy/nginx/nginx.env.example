# Settings for the nginx proxy service. Copy to nginx.env (git-ignored).
# Values are plain text: do not quote them.

# Host name the proxy answers to; _ matches any name.
NGINX_SERVER_NAME=_
# Compose service name and port of the web application on the shared network.
UPSTREAM_HOST=nfhotel-web
UPSTREAM_PORT=8080

# Market analysis service (MIL-004): the history notebook and the API, each on its
# own host name. The names resolve to the proxy host (use *.localhost locally).
ANALYSIS_SERVER_NAME=analysis.localhost
ANALYSIS_UPSTREAM_HOST=market-analysis-notebook
ANALYSIS_UPSTREAM_PORT=2718
ANALYSIS_API_SERVER_NAME=analysis-api.localhost
ANALYSIS_API_UPSTREAM_HOST=market-analysis-api
ANALYSIS_API_UPSTREAM_PORT=8000

# Read by docker compose (use: docker compose --env-file nginx.env up -d):
# address and host port the proxy is published on.
NGINX_BIND=0.0.0.0
NGINX_HTTP_PORT=8080
# Name of the Docker network shared with the web service.
NFHOTEL_PROXY_NETWORK=nfhotel-proxy
