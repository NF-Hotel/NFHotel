# NFHotel web application. Rendered by the nginx image at start: ${VAR}
# placeholders come from nginx.env, nginx's own $variables are left alone.
server {
  listen 80;
  server_name ${NGINX_SERVER_NAME};

  # Docker's embedded DNS. The upstream is resolved per request through a
  # variable, so the proxy starts and stays up when the web service is down.
  resolver 127.0.0.11 valid=10s;
  set $upstream http://${UPSTREAM_HOST}:${UPSTREAM_PORT};

  location / {
    proxy_pass $upstream;
    include /etc/nginx/snippets/proxy.conf;
  }
}
