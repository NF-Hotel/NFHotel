# Benchmark notebook. Rendered by the nginx image at start from nginx.env. Served on
# the internal listener (8081), published on the VM's loopback only: not on the
# internet.
server {
  listen 8081;
  server_name ${BENCHMARK_SERVER_NAME};

  resolver 127.0.0.11 valid=10s;
  set $upstream http://${BENCHMARK_UPSTREAM_HOST}:${BENCHMARK_UPSTREAM_PORT};

  location / {
    proxy_pass $upstream;
    include /etc/nginx/snippets/proxy.conf;
  }
}
