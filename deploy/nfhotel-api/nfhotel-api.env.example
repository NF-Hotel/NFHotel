# Settings for the NFHotel database API. Copy to nfhotel-api.env (git-ignored).
# Values are plain text: do not quote them. Never commit nfhotel-api.env.
# ASP.NET reads __ as the : separator of configuration keys.

ASPNETCORE_ENVIRONMENT=Development
# The database login is not set here: docker-compose.yml builds the connection string
# from deploy/postgres/postgres.env, so the password is written in one file only.
# 32 random bytes, base64. Create with: openssl rand -base64 32
Encryption__PassportKey=<base64-32-bytes>
HotelTime__TimeZoneId=Europe/Copenhagen
# The token that the web application must present, at least 32 characters. Create with:
# openssl rand -base64 32. scripts/deploy-services.sh passes the same value to the
# web service, so it is written here only.
Api__Token=<token-of-at-least-32-characters>

# Staff sign-in for the back office (MIL-016, ADR-0005). These secrets belong to the API only:
# the web application never holds them.
# The key that signs the staff tokens, at least 32 characters. Create with: openssl rand -base64 48
Staff__Token__SigningKey=<signing-key-of-at-least-32-characters>
# The first Manager, created at start when no staff account exists. The password has at least
# 12 characters; create one with: openssl rand -base64 18. More accounts are made with the
# create-staff command (docs/wiki/Proxmox-Deployment.md).
Staff__InitialManager__UserName=manager
Staff__InitialManager__Password=<password-of-at-least-12-characters>
# Apply the pending EF Core migrations when the API starts (the deploy relies on it).
Database__MigrateOnStart=true

# Name of the internal Docker network shared with the web service.
NFHOTEL_API_NETWORK=nfhotel-api
# Name of the internal Docker network shared with PostgreSQL.
NFHOTEL_DB_NETWORK=nfhotel-db

# The markets API that analyses the bookings (MIL-026, repository Notebook_Market_Analysis, deploy/market-analysis). The
# NFHotel API reaches it by the name market-analysis-api on the internal network nfhotel-api, and sends the bookings of
# the database to POST /analyze?insights=true. The call lasts as long as the AI models need, up to 6 x generation_timeout_seconds of market-analysis.toml, so the
# timeout is 90000 seconds (25 hours with the 14400 of a run at night; with the 240 seconds of a short run 1500 is enough). The markets API has no token; set one only for a gateway in front of it. An empty address makes
# the market analysis page say that the service is not set up. The address has no built-in default.
MarketAnalysisService__BaseUrl=http://market-analysis-api:8000
MarketAnalysisService__TimeoutSeconds=90000
MarketAnalysisService__Token=
