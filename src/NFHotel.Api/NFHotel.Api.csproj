<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    NFHotel.Api is the only process that talks to PostgreSQL and holds the passport key (ADR-0004).
    It hosts the use cases of the Application layer behind thin controllers (MVC) and is reached only
    from the web application, over an internal Docker network, with a bearer token.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Used by `dotnet user-secrets` for the development values of F5 (scripts/dev-f5.sh, ADR-0036): the connection
      string, the tokens and the keys stay outside the working folder, so they cannot be committed by mistake.
    -->
    <UserSecretsId>nfhotel-api-6b1e4c2a-3f57-4d8e-b0a9-71c5e2d48f16</UserSecretsId>
    <!--
      The OpenAPI document is written to g/openapi/nfhotel-api.json when the API is built, for the API scan of the
      end-to-end and DAST workflow and for the test that it names every endpoint (MIL-077). Version 3.0, which the
      API scan of OWASP ZAP reads. The build of the container has no artifacts folder; there it stays in obj.
    -->
    <OpenApiDocumentsDirectory Condition=" '$(ArtifactsPath)' != '' ">$(ArtifactsPath)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name nfhotel-api --openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Api.Contracts\NFHotel.Api.Contracts.csproj" />
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
    <ProjectReference Include="..\NFHotel.External\NFHotel.External.csproj" />
    <ProjectReference Include="..\NFHotel.Infrastructure\NFHotel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- Writes the OpenAPI document when the API is built; the running API does not serve it (MIL-077). -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
