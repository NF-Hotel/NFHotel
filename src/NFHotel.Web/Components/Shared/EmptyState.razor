@*
    Common "no data" state, so each list does not invent its own empty screen.

    UI-Spec section 4: an empty state must explain what the user can do — not just
    state that there is no data. Therefore it has room for an action in ChildContent.
*@

<div class="empty">
    <span class="empty-icon" aria-hidden="true">&#8212;</span>
    <p class="empty-title">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <p class="empty-text">@Text</p>
    }
    @if (ChildContent is not null)
    {
        <div class="row">
            @ChildContent
        </div>
    }
</div>

