@*
    The heading of the page with room for actions on the right.

    It writes the only <h1> of the page, which is also the element FocusOnNavigate moves
    focus to on page change — so a screen reader gets the name of the page first.
*@

<header class="page-header">
    <div class="stack-sm">
        <h1 class="title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="muted">@Subtitle</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="page-header-actions">
            @Actions
        </div>
    }
</header>

@code {
    /// <summary>The name of the page. Becomes the <c>h1</c> of the page.</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional subheading that explains what the page is for.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Optional actions — typically a primary button, for example "Create booking".</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
