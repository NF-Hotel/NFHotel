@*
    One message with a severity. For lists of errors from a ViewModel,
    ErrorAlert is used; this one is for the single receipt, warning or piece of information.

    The component does not translate error codes — the text must be finished Danish (ErrorMessages).
*@

@if (!string.IsNullOrWhiteSpace(Message) || ChildContent is not null)
{
    <div class="@BadgeClass.For(Kind)" role="@Role">
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p>@Message</p>
        }
        @ChildContent
    </div>
}

