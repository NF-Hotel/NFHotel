@*
    Neutral error display for the error list of a ViewModel. Takes finished translated Danish texts
    and shows them. The component does not translate by itself and knows no error codes — that is
    ErrorMessages' job.

    For a single message with an optional severity, AlertBox is used instead.
*@

@if (Errors.Count > 0)
{
    <div class="alert alert-error" role="alert">
        @if (Errors.Count == 1)
        {
            <p>@Errors[0]</p>
        }
        else
        {
            <ul>
                @foreach (var message in Errors)
                {
                    <li>@message</li>
                }
            </ul>
        }
    </div>
}

@code {
    /// <summary>The Danish error texts to show. An empty list hides the component.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<string> Errors { get; set; } = Array.Empty<string>();
}
