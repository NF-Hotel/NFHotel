@*
    A form field: label, input, error text, help text — always in that order.

    The input itself is supplied by the call site in ChildContent, so the component neither needs to
    know the type of the field nor bind to anything. In return it owns the label, so no
    input can end up without a <label> (UI-Spec section 4).

    The call site gives the input id="@For" and can point aria-describedby at
    "{For}-hint" and aria-errormessage at "{For}-error".
*@

<div class="field">
    <label class="field-label" for="@For">
        @Label@if (IsRequired)
        {<span class="field-required" title="Required">*</span>}
    </label>

    @ChildContent

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <span class="field-error" id="@($"{For}-error")" role="alert">@Error</span>
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <span class="field-hint" id="@($"{For}-hint")">@Hint</span>
    }
</div>

@code {
    /// <summary>The label above the field. Danish, without colon.</summary>
    [Parameter]
    [EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>The id of the input in <see cref="ChildContent"/>. Binds the label to the field.</summary>
    [Parameter]
    [EditorRequired]
    public string For { get; set; } = string.Empty;

    /// <summary>The input itself — <c>&lt;input class="field-input"&gt;</c>, a select or similar.</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Finished Danish error text. Empty means the field is in order.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Optional help text, for example the expected format.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>Marks the field as required with an asterisk at the label.</summary>
    [Parameter]
    public bool IsRequired { get; set; }
}
