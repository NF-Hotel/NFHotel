@*
    A form field: label, input, error text, help text — always in that order.

    The input itself is supplied by the call site in ChildContent, so the component neither needs to
    know the type of the field nor bind to anything. In return it owns the label, so no
    input can end up without a <label> (UI-Spec section 4).

    The call site gives the input id="@For" and can point aria-describedby at
    "{For}-hint" and aria-errormessage at "{For}-error".
*@

<div class="field">
    <label class="field-label" for="@For">
        @Label@if (IsRequired)
        {<span class="field-required" title="Required">*</span>}
    </label>

    @ChildContent

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <span class="field-error" id="@($"{For}-error")" role="alert">@Error</span>
    }

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <span class="field-hint" id="@($"{For}-hint")">@Hint</span>
    }
</div>

