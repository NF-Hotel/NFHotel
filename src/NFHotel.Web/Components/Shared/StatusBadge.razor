@*
    Status badge for the states of the domain. Set exactly one of the three parameters.

    The component contains no translation itself: the text comes from DisplayText and
    the class from BadgeClass, so the same status always looks and sounds the same across screens.
*@

@if (this.BookingStatus is not null)
{
    <span class="@BadgeClass.For(this.BookingStatus.Value)">@DisplayText.Describe(this.BookingStatus.Value)</span>
}
else if (this.RoomStatus is not null)
{
    <span class="@BadgeClass.For(this.RoomStatus.Value)">@DisplayText.Describe(this.RoomStatus.Value)</span>
}
else if (this.HousekeepingStatus is not null)
{
    <span class="@BadgeClass.For(this.HousekeepingStatus.Value)">@DisplayText.Describe(this.HousekeepingStatus.Value)</span>
}

