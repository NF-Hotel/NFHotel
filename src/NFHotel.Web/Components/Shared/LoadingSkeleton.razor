@*
    Loading state with the shape of the page preserved, so the layout does not jump when data arrives.
    UI-Spec section 4: no spinner in the middle of the screen.
*@

<div class="stack-sm" role="status" aria-busy="true" aria-label="Loading">
    @for (var row = 0; row < Rows; row++)
    {
        <span class="skeleton"></span>
    }
</div>

@code {
    /// <summary>Number of placeholder lines. Set it to match the content that is on its way.</summary>
    [Parameter]
    public int Rows { get; set; } = 3;
}
