@page "/Error"
@using System.Diagnostics

@*
    Central fejlside for uventede exceptions (UseExceptionHandler). Viser aldrig
    the exception type or the stack — only a neutral message and a trace id the staff can
    pass on to support (Conventions.md: "Show the user neutral error messages").
*@

<PageTitle>Error</PageTitle>

<div class="page-narrow stack">
    <h1 class="title">Something went wrong</h1>

    <p class="lede">We couldn't complete that action. Please try again, or contact support if it keeps happening.</p>

    @if (ShowRequestId)
    {
        <p class="muted">
            <strong>Reference ID:</strong> <code>@RequestId</code>
        </p>
    }

    <div class="row">
        <a class="btn btn-primary" href="/">Back to the front page</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
