@inherits LayoutComponentBase

@*
    The face of the hotel towards the outside. No side menu, no toolbar — a top bar, the content
    centred in --maxw, and a discreet footer. Anything that resembles the staff's work tool
    belongs in AdminLayout.
*@

<a class="skip-link" href="#content">Skip to content</a>

<header class="site-header">
    <div class="row-between">
        <a class="site-brand" href="/">NFHotel &amp; Bar</a>

        <nav class="site-nav" aria-label="Primary">
            <a class="btn btn-primary" href="/book">Book your stay</a>
        </nav>
    </div>
</header>

<main id="content">
    @Body
</main>

<footer class="site-footer">
    <div class="row-between">
        <p>
            NFHotel &amp; Bar &middot; Street 172, Phnom Penh, Cambodia &middot;
            <a href="mailto:help@nfhotel.com">help@nfhotel.com</a>
        </p>
        <p>Bar, kitchen and reception open around the clock</p>
    </div>
</footer>

@*
    Last net under the error handling: catches what no ViewModel could translate to an
    error code. The text is neutral and never reveals an exception (Conventions.md).
*@
<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>
