@inherits LayoutComponentBase
@using NFHotel.Web.Security

@*
    The staff's work tool: grouped side menu on the left, a top bar with the signed-in user, and the content
    (app.css section 12). Only a signed-in member of staff reaches these pages (ADR-0005).

    data-theme is the theme the user chose in the top bar (a cookie, AdminTheme); without it the shell
    follows the system. The layout is rendered on the server for every page, so the attribute is always current.
*@

<div class="admin-shell" data-theme="@Theme">
    <AdminIconSprite />
    <a class="skip-link" href="#content">Skip to content</a>

    <AdminNav />

    <div class="admin-main">
        <AdminTopbar Theme="@Theme" />
        <div class="page" id="content">
            @Body
        </div>
    </div>
</div>

@*
    Last net under the error handling: catches what no ViewModel could translate to an
    error code. The text is neutral and never reveals an exception (Conventions.md).
*@
<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Theme => AdminTheme.Read(HttpContext);
}
