@using NFHotel.Application.UseCases.Staff
@using NFHotel.Web.Security
@inject NavigationManager Navigation

@*
    The bar over the content: where the user is (group and page), the theme, and the signed-in user with
    the password page and sign-out (ADR-0005). Plain links, buttons and forms: no JavaScript (MIL-033), and no
    open state that survives a navigation.

    The theme button walks system → dark → light → system; the choice is a cookie (AdminTheme).
*@

<header class="admin-topbar">
    <nav class="admin-crumbs" aria-label="Breadcrumb">
        <span class="group">@Crumb.Group</span>
        <span class="sep" aria-hidden="true">/</span>
        <strong>@Crumb.Title</strong>
    </nav>

    <div class="admin-topbar-actions">
        <form method="post" action="@AdminTheme.TogglePath">
            <AntiforgeryToken />
            <input type="hidden" name="@AdminTheme.ReturnField" value="@Path" />
            <input type="hidden" name="@AdminTheme.Field" value="@NextTheme" />
            <button type="submit" class="admin-icon-btn" aria-label="@ThemeLabel" title="@ThemeLabel">
                <AdminIcon Name="@ThemeIcon" />
            </button>
        </form>

        <AuthorizeView>
            <a class="admin-user" href="/admin/account/password" title="Change password">
                <span class="admin-avatar" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                <span class="admin-user-name">
                    @context.User.Identity?.Name
                    <span>@StaffClaims.RoleOf(context.User)</span>
                </span>
            </a>
            <form method="post" action="@StaffSecurityRegistration.LogoutPath">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-ghost btn-sm admin-signout" aria-label="Sign out" title="Sign out">
                    <AdminIcon Name="logout" />
                    <span>Sign out</span>
                </button>
            </form>
        </AuthorizeView>
    </div>
</header>
