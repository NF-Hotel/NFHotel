@* Router. Finds pages under both Components/Pages/ and Features/ — feature first (A-13). *@

@*
    The default layout is the public one. The admin pages choose AdminLayout themselves with
    @@layout, so a new page never inherits the staff's side menu by accident.
*@

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.PublicLayout)">
            <NotAuthorized>
                @* A visitor who is not signed in goes to the login page; a signed-in user whose role lacks the permission is told so (ADR-0005). *@
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <LayoutView Layout="typeof(Layout.AdminLayout)">
                        <PageTitle>Not permitted — administration</PageTitle>
                        <NotPermitted Landing="@LandingPath(context.User)" />
                    </LayoutView>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.PublicLayout)">
            <PageTitle>Page not found</PageTitle>
            <div class="page-narrow stack">
                <h1 class="title">This page doesn't exist</h1>
                <p class="lede">That address leads nowhere. Start again from the front page, or go straight to booking.</p>
                <div class="row">
                    <a class="btn btn-primary" href="/">Go to the front page</a>
                    <a class="btn btn-secondary" href="/book">Book your stay</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static string LandingPath(System.Security.Claims.ClaimsPrincipal user) =>
        NFHotel.Web.Security.StaffClaims.RoleOf(user) is { } role
            ? NFHotel.Application.UseCases.Staff.RolePermissions.LandingPath(role)
            : "/";
}
