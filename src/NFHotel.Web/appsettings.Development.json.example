{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "Api": {
    "//": "The database API (NFHotel.Api). The token is the same as Api:Token in the API configuration: openssl rand -base64 32. The database connection and the passport key belong to the API, not to this file.",
    "BaseUrl": "http://127.0.0.1:5080",
    "Token": "<samme-token-som-api'et>"
  },

  "HotelTime": {
    "TimeZoneId": "Europe/Copenhagen"
  },

  "HolidayApi": {
    "//": "The analysis service (NF Hotel Analytics API). The ApiKey does NOT belong in this file: dotnet user-secrets set \"HolidayApi:ApiKey\" \"<the key>\" --project src/NFHotel.Web",
    "BaseUrl": "http://127.0.0.1:8000",
    "TimeoutSeconds": 30
  }
}
