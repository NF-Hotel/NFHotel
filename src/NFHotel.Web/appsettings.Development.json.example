{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "Api": {
    "//": "Databasens API (NFHotel.Api). Tokenet er det samme som Api:Token i API'ets konfiguration: openssl rand -base64 32. Databaseforbindelsen og pasnøglen hører til API'et, ikke til denne fil.",
    "BaseUrl": "http://127.0.0.1:5080",
    "Token": "<samme-token-som-api'et>"
  },

  "HotelTime": {
    "TimeZoneId": "Europe/Copenhagen"
  },

  "HolidayApi": {
    "//": "Analysetjenesten (NF Hotel Analytics API). ApiKey hører IKKE i denne fil: dotnet user-secrets set \"HolidayApi:ApiKey\" \"<nøglen>\" --project src/NFHotel.Web",
    "BaseUrl": "http://127.0.0.1:8000",
    "TimeoutSeconds": 30
  }
}
