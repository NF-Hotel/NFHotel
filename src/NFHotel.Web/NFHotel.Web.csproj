<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    NFHotel.Web er composition root. Den refererer Application (kontrakterne
    komponenterne kalder), ApiClient (use cases over HTTP, ADR-0004) og External (uret og helligdagene).
    Den refererer ikke Infrastructure: webapplikationen har hverken databaseadgang eller EF Core.
    Ingen komponent og ingen ViewModel må røre EF Core eller Npgsql (B-10).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Bruges af `dotnet user-secrets` til udviklingsværdier der aldrig må i repoet, fx
      HolidayApi:ApiKey. Ligger uden for arbejdsmappen, så den ikke kan committes ved en fejl.
    -->
    <UserSecretsId>nfhotel-web-2c1f6a3e-8d4b-4b7e-9a51-0e7c5d2b9f34</UserSecretsId>

    <!--
      Samme bar som NFHotel.Infrastructure: 0 advarsler er et krav, ikke et mål.
      Uden TreatWarningsAsErrors bliver den første advarsel hurtigt til femten.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
    <ProjectReference Include="..\NFHotel.ApiClient\NFHotel.ApiClient.csproj" />
    <ProjectReference Include="..\NFHotel.External\NFHotel.External.csproj" />
  </ItemGroup>

</Project>
