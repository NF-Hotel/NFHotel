<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    NFHotel.Web is the composition root. It references Application (the contracts
    that the components call), ApiClient (use cases over HTTP, ADR-0004) and External (the clock and the holidays).
    It does not reference Infrastructure: the web application has no database access and no EF Core.
    No component and no ViewModel may touch EF Core or Npgsql (B-10).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Used by `dotnet user-secrets` for development values that must never be in the repository, for example
      HolidayApi:ApiKey. It is outside the working folder, so it cannot be committed by mistake.
    -->
    <UserSecretsId>nfhotel-web-2c1f6a3e-8d4b-4b7e-9a51-0e7c5d2b9f34</UserSecretsId>

    <!--
      The same bar as NFHotel.Infrastructure: 0 warnings is a requirement, not a goal.
      Without TreatWarningsAsErrors the first warning quickly becomes fifteen.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
    <ProjectReference Include="..\NFHotel.ApiClient\NFHotel.ApiClient.csproj" />
    <ProjectReference Include="..\NFHotel.External\NFHotel.External.csproj" />
  </ItemGroup>

</Project>
