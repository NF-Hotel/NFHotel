<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    NFHotel.Web is the composition root. It references Application (the contracts
    that the components call), ApiClient (use cases over HTTP, ADR-0004) and External (the clock and the holidays).
    It does not reference Infrastructure: the web application has no database access and no EF Core.
    No component and no ViewModel may touch EF Core or Npgsql (B-10).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Used by `dotnet user-secrets` for development values that must never be in the repository, for example
      HolidayApi:ApiKey. It is outside the working folder, so it cannot be committed by mistake.
    -->
    <UserSecretsId>nfhotel-web-2c1f6a3e-8d4b-4b7e-9a51-0e7c5d2b9f34</UserSecretsId>

    <!--
      The same bar as NFHotel.Infrastructure: 0 warnings is a requirement, not a goal.
      Without TreatWarningsAsErrors the first warning quickly becomes fifteen.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Blazor on .NET 10 sends the redirect of a static server-rendered page (the sign-in, the password change)
      without throwing NavigationException when this is set, as the .NET 10 template sets it. Without it, Visual
      Studio stops at every Navigation.NavigateTo under F5. Code after NavigateTo now runs, so a NavigateTo that
      is not the last statement of its method needs a return. NFHotel.Web.Tests sets the same runtime switch.
    -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdown of the AI texts of the market analysis report (MIL-026 task 23); HTML is disabled and links are removed in MarkdownText. -->
    <PackageReference Include="Markdig" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
    <ProjectReference Include="..\NFHotel.ApiClient\NFHotel.ApiClient.csproj" />
    <ProjectReference Include="..\NFHotel.External\NFHotel.External.csproj" />
  </ItemGroup>

</Project>
