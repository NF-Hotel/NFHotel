@*
    One pin on the map of the neighbourhood: the dot, its number and the name beside it. Its own component
    because Razor reserves <text> inside a code block, and the pins are drawn in a loop. The name goes to the
    left of the dot when the place says so, so it does not cover a neighbour.
*@

<g class="@PinClass" transform="translate(@Place.X @Place.Y)" @onclick="OnSelect">
    <circle class="m-pin-dot" r="12" />
    <text class="m-pin-num">@Number</text>
    <text class="@LabelClass" x="@LabelX" y="4">@Place.Name</text>
</g>

@code {
    /// <summary>The place the pin stands for.</summary>
    [Parameter]
    [EditorRequired]
    public NeighbourhoodPlace Place { get; set; } = null!;

    /// <summary>The number in the dot, the same as in the list under the map.</summary>
    [Parameter]
    [EditorRequired]
    public int Number { get; set; }

    /// <summary>The classes of the pin, from the viewmodel, so the chosen pin is drawn filled.</summary>
    [Parameter]
    [EditorRequired]
    public string PinClass { get; set; } = string.Empty;

    /// <summary>Raised when the pin is clicked or tapped.</summary>
    [Parameter]
    public EventCallback OnSelect { get; set; }

    private string LabelClass => Place.LabelOnLeft ? "m-pin-label m-pin-label-left" : "m-pin-label";

    private int LabelX => Place.LabelOnLeft ? -18 : 18;
}
