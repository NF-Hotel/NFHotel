@page "/admin/benchmark/start"
@layout NFHotel.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = StaffPolicies.BenchmarkRun)]
@rendermode InteractiveServer
@inherits NFHotel.Web.Common.CancellableComponentBase
@using NFHotel.Application.Dto.Benchmark
@using NFHotel.Web.Features.Admin.Benchmark
@inject BenchmarkStartViewModel ViewModel

@*
    Start a benchmark run (MIL-020, ADR-0001 of the benchmark service). Only markup and binding.

    The page is for the Manager only: the policy above is the check that ADR-0001 asks for before the benchmark service is
    called. The service checks its limits again. A start returns at once; the page then asks for the state every few
    seconds until the run is done and its result is stored, and links to the list of runs. Every run is recorded through
    the API (ADR-0031): the page picks up a run that is still going, shows one that a restart of the service stopped, and
    takes the choice of a run named by ?again= from the list of runs.
*@

<PageTitle>Start a benchmark run — administration</PageTitle>

<div class="stack-lg">
    <PageHeader Title="Start a benchmark run"
                Subtitle="Choose the installed models to compare. A run takes minutes and runs one model at a time." />

    <AdminTabs Label="Benchmark" Tabs="BenchmarkTabs" />

    <ErrorAlert Errors="ViewModel.Errors" />

    @if (ViewModel.StoppedRun is { } stopped)
    {
        <section class="card card-pad stack-sm" aria-labelledby="stopped-run">
            <h2 class="subtitle" id="stopped-run">The last run did not finish</h2>
            <p>
                @string.Join(", ", stopped.Models), started by @stopped.RequestedBy at
                @stopped.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture):
                <strong>@stopped.State</strong>@(stopped.Error is null ? "." : $". {stopped.Error}")
            </p>
            <div>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ViewModel.UseChoiceOf(stopped)">
                    Use the same choice
                </button>
            </div>
        </section>
    }

    <AuthorizeView Policy="@StaffPolicies.BenchmarkModelsManage">
        <ModelsPanel OnModelsChanged="ReloadModelsAsync" />
    </AuthorizeView>

    @if (!ViewModel.IsLoaded)
    {
        <LoadingSkeleton Rows="4" />
    }
    else if (ViewModel.Models.Count == 0 && ViewModel.Errors.Count == 0)
    {
        <EmptyState Title="No model is installed"
                    Description="Install the models on the benchmark service first, then come back." />
    }
    else if (ViewModel.Models.Count > 0)
    {
        <section class="card card-pad stack" aria-labelledby="run-choice">
            <h2 class="subtitle" id="run-choice">Models</h2>

            <fieldset class="stack-sm">
                <legend class="visually-hidden-legend">Models, one to @BenchmarkStartViewModel.MaxModels</legend>
                @foreach (var model in ViewModel.Models)
                {
                    <label class="check">
                        <input type="checkbox"
                               checked="@ViewModel.SelectedModels.Contains(model)"
                               disabled="@(ViewModel.IsBusy || ViewModel.IsFollowing)"
                               @onchange="() => ViewModel.ToggleModel(model)" />
                        @model
                    </label>
                }
            </fieldset>

            <div class="field-row">
                <label class="check">
                    <input type="checkbox" @bind="ViewModel.HotelAnalysis" disabled="@(ViewModel.IsBusy || ViewModel.IsFollowing)" />
                    Hotel cancellation analysis
                </label>
                <label class="check">
                    <input type="checkbox" @bind="ViewModel.DeterministicTasks" disabled="@(ViewModel.IsBusy || ViewModel.IsFollowing)" />
                    Deterministic tasks
                </label>
                <FormField Label="Runs per model" For="benchmark-runs">
                    <input id="benchmark-runs"
                           class="field-input"
                           type="number"
                           min="1"
                           max="@BenchmarkStartViewModel.MaxRuns"
                           disabled="@(ViewModel.IsBusy || ViewModel.IsFollowing)"
                           @bind="ViewModel.Runs" />
                </FormField>
            </div>

            <div>
                <button type="button"
                        class="btn btn-primary"
                        disabled="@(!ViewModel.CanStart)"
                        @onclick="StartAsync">
                    Start the run
                </button>
            </div>
        </section>
    }

    @if (ViewModel.IsLoaded)
    {
        <section class="card card-pad stack" aria-labelledby="runs-live">
            <h2 class="subtitle" id="runs-live">Runs</h2>
            <p class="muted">
                What the benchmark service knows: queued, running and the recent runs, whoever started them. The list follows a
                change within a few seconds; it is not lost by a refresh. The service forgets it when it restarts, but a result that
                was stored stays in the list of runs.
            </p>

            @if (!ViewModel.IsLive)
            {
                <AlertBox Kind="AlertKind.Info" Message="Live updates are paused: the benchmark service could not be reached. The list shows the last state that was read." />
            }

            @if (ViewModel.KnownRuns.Count == 0)
            {
                <p>No run is queued or running, and the service has no recent run.</p>
            }
            else
            {
                <div class="table-wrap" role="status" aria-live="polite">
                    <table class="table">
                        <caption>@ViewModel.KnownRuns.Count runs, newest first</caption>
                        <thead>
                            <tr>
                                <th scope="col">Queued</th>
                                <th scope="col">Models</th>
                                <th scope="col">State</th>
                                <th scope="col">Result</th>
                                <th scope="col" class="table-actions">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in ViewModel.KnownRuns)
                            {
                                <tr>
                                    <td>@Time(run.QueuedAt)</td>
                                    <td>@string.Join(", ", run.Models)</td>
                                    <td><strong>@run.State</strong>@SinceText(run)</td>
                                    <td>@Delivery(run)</td>
                                    <td>
                                        @if (run.State == BenchmarkRunStates.Failed)
                                        {
                                            <span class="muted">@(run.Error ?? "The run failed.")</span>
                                        }
                                        else if (run.Delivery == BenchmarkDeliveryStates.Delivered)
                                        {
                                            <a class="btn btn-secondary btn-sm" href="/admin/benchmark">Open the list of runs</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>
