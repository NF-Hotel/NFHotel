@page "/admin/benchmark"
@layout NFHotel.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = StaffPolicies.BenchmarkView)]
@rendermode InteractiveServer
@inherits NFHotel.Web.Common.CancellableComponentBase
@using System.Globalization
@using NFHotel.Application.Dto.Benchmark
@using NFHotel.Domain.Entities
@using NFHotel.Web.Features.Admin.Benchmark
@inject BenchmarkRunListViewModel ViewModel

@*
    The benchmark runs that the benchmark service delivered (ADR-0013, MIL-019). Only markup and binding.

    The list never carries an answer text: the answer of one request is read on its own with its button, because it can
    be long. The memory figures are what the machine had in use, not what the model alone used (BENCHMARK_METHODOLOGY.md).
    Above it, the started runs without a stored result (ADR-0031): one that a restart of the service stopped is shown as
    interrupted and can be started again with the same choice.
*@

<PageTitle>Benchmark runs — administration</PageTitle>

<div class="stack-lg">
    <PageHeader Title="Benchmark runs"
                Subtitle="Every finished run of the local models, with the machine it ran on.">
        <Actions>
            <AuthorizeView Policy="@StaffPolicies.BenchmarkRun">
                <a class="btn btn-primary" href="/admin/benchmark/start"><AdminIcon Name="cpu" />Start a run</a>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <AdminTabs Label="Benchmark" Tabs="BenchmarkTabs" />

    <ErrorAlert Errors="ViewModel.Errors" />

    @if (ViewModel.RunPendingDeletion is { } pending)
    {
        <ConfirmPanel Title="@($"Delete the run of {pending.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)} UTC?")"
                      Message="The run, its measurements and every answer are removed for good. This cannot be undone."
                      ConfirmLabel="Delete run"
                      IsBusy="ViewModel.IsBusy"
                      OnConfirm="ConfirmDeleteAsync"
                      OnCancel="ViewModel.AbortDelete" />
    }

    @if (ViewModel.IsLoaded)
    {
        <section class="card" aria-labelledby="ai-defaults">
            <CardHead Id="ai-defaults"
                      Title="Default AI model"
                      Hint="The model that the website and the market analysis use unless they are told otherwise. Choose it from the results below, or type the name of an installed model. The market analysis reads it the next time it is deployed."
                      Icon="key"
                      Tint="navy" />
            <div class="card-body stack">
            @if (ViewModel.DefaultPull is { } pull)
            {
                <div role="status" aria-live="polite">
                    @switch (pull.State)
                    {
                        case ModelPullStates.Done:
                            <AlertBox Kind="AlertKind.Ok" Message="@($"{pull.Model} is installed and saved as the default.")" />
                            break;
                        case ModelPullStates.Failed:
                            <AlertBox Kind="AlertKind.Error" Message="@($"{pull.Model} could not be downloaded: {pull.Error ?? "the model server gave no reason"}. The default is not changed.")" />
                            break;
                        default:
                            <p>
                                Downloading <strong>@pull.Model</strong> before it is saved as the default:
                                @(pull.State == ModelPullStates.Queued ? "waiting" : pull.Percent is { } percent ? $"{percent} %" : "starting")
                            </p>
                            @if (pull.Percent is { } shown)
                            {
                                <progress max="100" value="@shown" aria-label="Download of @pull.Model">@shown %</progress>
                            }

                            break;
                    }
                </div>
            }
            <datalist id="known-models">
                @foreach (var model in ViewModel.KnownModels)
                {
                    <option value="@model"></option>
                }
            </datalist>
            @foreach (var purpose in Purposes)
            {
                var current = ViewModel.DefaultOf(purpose);
                var fieldId = $"default-ai-{purpose}";
                <div class="default-row">
                    <div class="default-current">
                        <strong>@Title(purpose)</strong>
                        @if (current is null)
                        {
                            <span class="muted">no default set</span>
                        }
                        else
                        {
                            <span>@current.Model, set by @current.SetBy @current.SetAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</span>
                        }
                    </div>
                    <AuthorizeView Policy="@StaffPolicies.AiDefaultsManage">
                        <label class="sr-only" for="@fieldId">Default model for @ViewModel.LabelOfPurpose(purpose)</label>
                        <input id="@fieldId"
                               class="field-input"
                               list="known-models"
                               maxlength="100"
                               disabled="@ViewModel.IsBusy"
                               value="@ViewModel.DraftOf(purpose)"
                               @onchange="args => ViewModel.SetDraft(purpose, args.Value?.ToString())" />
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                disabled="@(ViewModel.IsBusy || string.IsNullOrWhiteSpace(ViewModel.DraftOf(purpose)))"
                                @onclick="() => SaveDefaultAsync(purpose)">
                            Save
                        </button>
                    </AuthorizeView>
                </div>
                @if (ViewModel.IsUnknownModel(purpose))
                {
                    <p class="field-hint" role="note">
                        No stored run used this name. A service uses a model only when the name is exactly the one that the
                        model server lists, tag included: take it from <code>ollama list</code>, for example <code>phi3.5:latest</code>.
                    </p>
                }
            }
            </div>
        </section>
    }

    @if (ViewModel.StartedRuns.Count > 0)
    {
        <section class="card" aria-labelledby="started-runs">
        <CardHead Id="started-runs" Title="Started runs" Count="ViewModel.StartedRuns.Count" Hint="Runs without a stored result, newest first." Icon="clock" Tint="amber" />
        <div class="table-wrap">
            <table class="table">
                <caption class="sr-only">Started runs without a stored result, newest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Started</th>
                        <th scope="col">Models</th>
                        <th scope="col">By</th>
                        <th scope="col">State</th>
                        <th scope="col" class="table-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var started in ViewModel.StartedRuns)
                    {
                        <tr>
                            <td class="nowrap">@started.RequestedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</td>
                            <td>@string.Join(", ", started.Models)</td>
                            <td>@started.RequestedBy</td>
                            <td><strong>@started.State</strong>@(started.Error is null ? string.Empty : $": {started.Error}")</td>
                            <td class="table-actions">
                                <AuthorizeView Policy="@StaffPolicies.BenchmarkRun">
                                    @if (started.IsOpen)
                                    {
                                        <a class="btn btn-secondary btn-sm" href="/admin/benchmark/start">Follow</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-secondary btn-sm" href="@($"/admin/benchmark/start?again={started.RunId}")">Start again</a>
                                    }
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </section>
    }

    @if (!ViewModel.IsLoaded)
    {
        <LoadingSkeleton Rows="4" />
    }
    else if (ViewModel.IsEmpty)
    {
        <EmptyState Title="No benchmark run has been stored yet"
                    Description="A run appears here when the benchmark service has finished it and delivered the result." />
    }
    else if (ViewModel.Runs.Count > 0)
    {
        <section class="card" aria-labelledby="stored-runs">
        <CardHead Id="stored-runs" Title="Stored runs" Count="ViewModel.Runs.Count" Hint="Newest first. Open a run to see its analysis." Icon="cpu" />
        <div class="table-wrap">
            <table class="table">
                <caption class="sr-only">@ViewModel.Runs.Count runs, newest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Started</th>
                        <th scope="col">Models</th>
                        <th scope="col" class="numeric">Requests</th>
                        <th scope="col">Machine</th>
                        <th scope="col">Dataset</th>
                        <th scope="col" class="table-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in ViewModel.Runs)
                    {
                        <tr class="@(ViewModel.SelectedRun?.Header.RunId == run.RunId ? "is-selected" : null)">
                            <td class="nowrap">@run.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</td>
                            <td>@string.Join(", ", run.Models)</td>
                            <td class="numeric">@run.RequestCount</td>
                            <td>@Machine(run)</td>
                            <td>@run.DatasetName</td>
                            <td class="table-actions">
                                <button type="button"
                                        class="btn @(ViewModel.SelectedRun?.Header.RunId == run.RunId ? "btn-secondary" : "btn-primary") btn-sm"
                                        disabled="@ViewModel.IsBusy"
                                        aria-expanded="@(ViewModel.SelectedRun?.Header.RunId == run.RunId)"
                                        @onclick="() => SelectAsync(run.RunId)">
                                    @(ViewModel.SelectedRun?.Header.RunId == run.RunId ? "Close" : "Open")
                                </button>
                                <AuthorizeView Policy="@StaffPolicies.BenchmarkDelete">
                                    <button type="button"
                                            class="btn btn-danger btn-sm btn-icon"
                                            title="Delete this run"
                                            disabled="@ViewModel.IsBusy"
                                            @onclick="() => ViewModel.RequestDelete(run)">
                                        <AdminIcon Name="trash" /><span class="sr-only">Delete</span>
                                    </button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </section>
    }

    @if (ViewModel.SelectedRun is { } selected)
    {
        <div class="stack-lg run-details">
            <section class="card card-feature" aria-labelledby="run-details">
                <CardHead Id="run-details"
                          Title="@($"Run of {selected.Header.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)} UTC")"
                          Icon="cpu"
                          Tint="navy">
                    <Actions>
                        <span class="run-id">Run @selected.Header.RunId</span>
                    </Actions>
                </CardHead>
                <div class="card-body">
                    <dl class="facts">
                        <div><dt>Machine</dt><dd>@Machine(selected.Header), @selected.CpuCores cores</dd></div>
                        <div><dt>System</dt><dd>@selected.OperatingSystem</dd></div>
                        <div><dt>Backend</dt><dd>@selected.Header.BackendName @selected.Header.BackendVersion</dd></div>
                        <div><dt>Dataset</dt><dd>@selected.Header.DatasetName (@selected.DatasetRows rows)</dd></div>
                        <div><dt>Prompt</dt><dd>@selected.PromptVersion</dd></div>
                        <div><dt>Requests</dt><dd>@selected.Results.Count</dd></div>
                    </dl>
                </div>
            </section>

            <BenchmarkRunAnalysis Run="selected" />

            <section class="card" aria-labelledby="run-requests">
                <CardHead Id="run-requests"
                          Title="Every request"
                          Count="selected.Results.Count"
                          Hint="The raw measurements of the run, one row per request. Open an answer to read what the model wrote."
                          Icon="list"
                          Tint="slate" />
                <details class="requests" open="@(ViewModel.ShownOutput is not null)">
                    <summary>Show the @selected.Results.Count requests</summary>
                    <div class="table-wrap">
                        <table class="table table-compact">
                            <caption class="sr-only">@selected.Results.Count requests</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Model</th>
                                    <th scope="col">Task</th>
                                    <th scope="col" class="numeric">Run</th>
                                    <th scope="col">Start</th>
                                    <th scope="col" class="numeric">First token (s)</th>
                                    <th scope="col" class="numeric">Total (s)</th>
                                    <th scope="col" class="numeric">Tokens</th>
                                    <th scope="col" class="numeric">Tokens/s</th>
                                    <th scope="col" class="numeric">RAM peak (MB)</th>
                                    <th scope="col" class="numeric">GPU peak (MB)</th>
                                    <th scope="col">Outcome</th>
                                    <th scope="col" class="table-actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in selected.Results)
                                {
                                    <tr>
                                        <td class="nowrap"><strong>@result.Model</strong></td>
                                        <td class="nowrap">@TaskName(result)</td>
                                        <td class="numeric">@(result.RunNumber + 1)</td>
                                        <td>@(result.Cold ? "cold" : "warm")</td>
                                        <td class="numeric">@Number(result.TimeToFirstTokenSeconds)</td>
                                        <td class="numeric">@Number(result.TotalSeconds)</td>
                                        <td class="numeric">@result.CompletionTokens@(result.TokensEstimated ? " (est.)" : string.Empty)</td>
                                        <td class="numeric">@Number(result.TokensPerSecond)</td>
                                        <td class="numeric">@Number(result.RamPeakMb)</td>
                                        <td class="numeric">@Number(result.VramPeakMb)</td>
                                        <td class="nowrap">@Outcome(result)</td>
                                        <td class="table-actions">
                                            <button type="button"
                                                    class="btn btn-ghost btn-sm"
                                                    disabled="@ViewModel.IsBusy"
                                                    @onclick="() => ShowOutputAsync(result.BenchmarkResultId)">
                                                Show answer
                                            </button>
                                            <AuthorizeView Policy="@StaffPolicies.AiDefaultsManage">
                                                @foreach (var purpose in Purposes)
                                                {
                                                    <button type="button"
                                                            class="btn btn-secondary btn-sm"
                                                            disabled="@ViewModel.IsBusy"
                                                            @onclick="() => SetDefaultAsync(purpose, result.Model, selected.Header.RunId)">
                                                        Use for @ViewModel.LabelOfPurpose(purpose)
                                                    </button>
                                                }
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            </section>

            @if (ViewModel.ShownOutput is { } output)
            {
                <section class="card" aria-labelledby="run-answer">
                    <CardHead Id="run-answer" Title="@($"Answer of {output.Model}")" Icon="sparkle" Tint="amber">
                        <Actions>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="ViewModel.HideOutput">Hide the answer</button>
                        </Actions>
                    </CardHead>
                    <div class="card-body stack-sm">
                        @if (!string.IsNullOrWhiteSpace(output.Error))
                        {
                            <AlertBox Kind="AlertKind.Error" Message="@output.Error" />
                        }
                        @if (!string.IsNullOrWhiteSpace(output.ValidationError))
                        {
                            <AlertBox Kind="AlertKind.Info" Message="@output.ValidationError" />
                        }
                        <pre class="answer-text">@output.Output</pre>
                    </div>
                </section>
            }
        </div>
    }
</div>
