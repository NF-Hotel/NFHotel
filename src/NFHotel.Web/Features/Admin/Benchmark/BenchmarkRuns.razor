@page "/admin/benchmark"
@layout NFHotel.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = StaffPolicies.BenchmarkView)]
@rendermode InteractiveServer
@inherits NFHotel.Web.Common.CancellableComponentBase
@using System.Globalization
@using NFHotel.Application.Dto.Benchmark
@using NFHotel.Domain.Entities
@using NFHotel.Web.Features.Admin.Benchmark
@inject BenchmarkRunListViewModel ViewModel

@*
    The benchmark runs that the benchmark service delivered (ADR-0013, MIL-019). Only markup and binding.

    The list never carries an answer text: the answer of one request is read on its own with its button, because it can
    be long. The memory figures are what the machine had in use, not what the model alone used (BENCHMARK_METHODOLOGY.md).
*@

<PageTitle>Benchmark runs — administration</PageTitle>

<div class="stack-lg">
    <PageHeader Title="Benchmark runs"
                Subtitle="Every finished run of the local models, with the machine it ran on.">
        <Actions>
            <AuthorizeView Policy="@StaffPolicies.BenchmarkRun">
                <a class="btn btn-primary" href="/admin/benchmark/start">Start a run</a>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <ErrorAlert Errors="ViewModel.Errors" />

    @if (ViewModel.RunPendingDeletion is { } pending)
    {
        <ConfirmPanel Title="@($"Delete the run of {pending.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)} UTC?")"
                      Message="The run, its measurements and every answer are removed for good. This cannot be undone."
                      ConfirmLabel="Delete run"
                      IsBusy="ViewModel.IsBusy"
                      OnConfirm="ConfirmDeleteAsync"
                      OnCancel="ViewModel.AbortDelete" />
    }

    @if (ViewModel.IsLoaded)
    {
        <section class="card card-pad stack-sm" aria-labelledby="ai-defaults">
            <h2 class="subtitle" id="ai-defaults">Default AI model</h2>
            <p class="muted">
                The model that the website and the market analysis use unless they are told otherwise. Choose it from the
                results below, or type the name of an installed model. The market analysis reads it the next time it is deployed.
            </p>
            <datalist id="known-models">
                @foreach (var model in ViewModel.KnownModels)
                {
                    <option value="@model"></option>
                }
            </datalist>
            @foreach (var purpose in Purposes)
            {
                var current = ViewModel.DefaultOf(purpose);
                var fieldId = $"default-ai-{purpose}";
                <div class="field-row">
                    <div>
                        <strong>@Title(purpose)</strong>:
                        @if (current is null)
                        {
                            <span>no default set</span>
                        }
                        else
                        {
                            <span>@current.Model, set by @current.SetBy @current.SetAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</span>
                        }
                    </div>
                    <AuthorizeView Policy="@StaffPolicies.AiDefaultsManage">
                        <label class="sr-only" for="@fieldId">Default model for @ViewModel.LabelOfPurpose(purpose)</label>
                        <input id="@fieldId"
                               class="field-input"
                               list="known-models"
                               maxlength="100"
                               disabled="@ViewModel.IsBusy"
                               value="@ViewModel.DraftOf(purpose)"
                               @onchange="args => ViewModel.SetDraft(purpose, args.Value?.ToString())" />
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                disabled="@(ViewModel.IsBusy || string.IsNullOrWhiteSpace(ViewModel.DraftOf(purpose)))"
                                @onclick="() => SaveDefaultAsync(purpose)">
                            Save
                        </button>
                    </AuthorizeView>
                </div>
            }
        </section>
    }

    @if (!ViewModel.IsLoaded)
    {
        <LoadingSkeleton Rows="4" />
    }
    else if (ViewModel.IsEmpty)
    {
        <EmptyState Title="No benchmark run has been stored yet"
                    Description="A run appears here when the benchmark service has finished it and delivered the result." />
    }
    else if (ViewModel.Runs.Count > 0)
    {
        <div class="table-wrap">
            <table class="table">
                <caption>@ViewModel.Runs.Count runs, newest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Started</th>
                        <th scope="col">Models</th>
                        <th scope="col" class="numeric">Requests</th>
                        <th scope="col">Machine</th>
                        <th scope="col">Dataset</th>
                        <th scope="col" class="table-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in ViewModel.Runs)
                    {
                        <tr>
                            <td>@run.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</td>
                            <td>@string.Join(", ", run.Models)</td>
                            <td class="numeric">@run.RequestCount</td>
                            <td>@Machine(run)</td>
                            <td>@run.DatasetName</td>
                            <td>
                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        disabled="@ViewModel.IsBusy"
                                        aria-expanded="@(ViewModel.SelectedRun?.Header.RunId == run.RunId)"
                                        @onclick="() => SelectAsync(run.RunId)">
                                    @(ViewModel.SelectedRun?.Header.RunId == run.RunId ? "Close" : "Open")
                                </button>
                                <AuthorizeView Policy="@StaffPolicies.BenchmarkDelete">
                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            disabled="@ViewModel.IsBusy"
                                            @onclick="() => ViewModel.RequestDelete(run)">
                                        Delete
                                    </button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (ViewModel.SelectedRun is { } selected)
    {
        <section class="card card-pad stack" aria-labelledby="run-details">
            <h2 class="subtitle" id="run-details">Run @selected.Header.RunId</h2>
            <p>
                @Machine(selected.Header), @selected.CpuCores cores, @selected.OperatingSystem.
                Backend @selected.Header.BackendName @selected.Header.BackendVersion.
                Dataset @selected.Header.DatasetName (@selected.DatasetRows rows), prompt @selected.PromptVersion.
            </p>

            <div class="table-wrap">
                <table class="table">
                    <caption>@selected.Results.Count requests</caption>
                    <thead>
                        <tr>
                            <th scope="col">Model</th>
                            <th scope="col">Task</th>
                            <th scope="col" class="numeric">Run</th>
                            <th scope="col">Start</th>
                            <th scope="col" class="numeric">First token (s)</th>
                            <th scope="col" class="numeric">Total (s)</th>
                            <th scope="col" class="numeric">Tokens</th>
                            <th scope="col" class="numeric">Tokens/s</th>
                            <th scope="col" class="numeric">RAM peak (MB)</th>
                            <th scope="col" class="numeric">GPU peak (MB)</th>
                            <th scope="col">Outcome</th>
                            <th scope="col" class="table-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in selected.Results)
                        {
                            <tr>
                                <td>@result.Model</td>
                                <td>@TaskName(result)</td>
                                <td class="numeric">@(result.RunNumber + 1)</td>
                                <td>@(result.Cold ? "cold" : "warm")</td>
                                <td class="numeric">@Number(result.TimeToFirstTokenSeconds)</td>
                                <td class="numeric">@Number(result.TotalSeconds)</td>
                                <td class="numeric">@result.CompletionTokens@(result.TokensEstimated ? " (est.)" : string.Empty)</td>
                                <td class="numeric">@Number(result.TokensPerSecond)</td>
                                <td class="numeric">@Number(result.RamPeakMb)</td>
                                <td class="numeric">@Number(result.VramPeakMb)</td>
                                <td>@Outcome(result)</td>
                                <td>
                                    <button type="button"
                                            class="btn btn-ghost btn-sm"
                                            disabled="@ViewModel.IsBusy"
                                            @onclick="() => ShowOutputAsync(result.BenchmarkResultId)">
                                        Show answer
                                    </button>
                                    <AuthorizeView Policy="@StaffPolicies.AiDefaultsManage">
                                        @foreach (var purpose in Purposes)
                                        {
                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    disabled="@ViewModel.IsBusy"
                                                    @onclick="() => ViewModel.SetDefaultAsync(purpose, result.Model, selected.Header.RunId, ComponentToken)">
                                                Use for @ViewModel.LabelOfPurpose(purpose)
                                            </button>
                                        }
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewModel.ShownOutput is { } output)
            {
                <section class="stack-sm" aria-labelledby="run-answer">
                    <h3 class="subtitle" id="run-answer">Answer of @output.Model</h3>
                    @if (!string.IsNullOrWhiteSpace(output.Error))
                    {
                        <AlertBox Kind="AlertKind.Error" Message="@output.Error" />
                    }
                    @if (!string.IsNullOrWhiteSpace(output.ValidationError))
                    {
                        <AlertBox Kind="AlertKind.Info" Message="@output.ValidationError" />
                    }
                    <pre class="answer-text">@output.Output</pre>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="ViewModel.HideOutput">Hide the answer</button>
                </section>
            }
        </section>
    }
</div>

@code {
    /// <summary>Loads the list when the page opens.</summary>
    protected override Task OnInitializedAsync() => ViewModel.InitializeAsync(ComponentToken);

    private static readonly string[] Purposes = [AiDefault.Website, AiDefault.MarketAnalysis];

    private static string Title(string purpose) =>
        purpose == AiDefault.Website ? "Website" : "Market analysis";

    private Task SaveDefaultAsync(string purpose) => ViewModel.SaveDefaultAsync(purpose, ComponentToken);

    private Task ConfirmDeleteAsync() => ViewModel.ConfirmDeleteAsync(ComponentToken);

    private Task SelectAsync(Guid runId) => ViewModel.SelectAsync(runId, ComponentToken);

    private Task ShowOutputAsync(int benchmarkResultId) => ViewModel.ShowOutputAsync(benchmarkResultId, ComponentToken);

    private static string Machine(BenchmarkRunListItemDto run) =>
        $"{run.Cpu}, {run.MemoryMb / 1024d:0.#} GiB, {(string.IsNullOrWhiteSpace(run.Gpu) ? "CPU only" : run.Gpu)}";

    private static string TaskName(BenchmarkResultDto result) =>
        string.Equals(result.AnalysisType, "hotel_cancellation", StringComparison.Ordinal)
            ? "Hotel cancellation analysis"
            : result.TaskId ?? result.AnalysisType;

    private static string Number(double? value) =>
        value is { } number ? number.ToString("0.##", CultureInfo.InvariantCulture) : "—";

    private static string Outcome(BenchmarkResultDto result) =>
        result.HasError ? "error"
        : result.Passed is { } passed ? (passed ? "passed" : "failed")
        : result.ResponseValid is { } valid ? (valid ? "valid answer" : "invalid answer")
        : "—";
}
