@using System.Globalization
@using NFHotel.Web.Features.Admin.Benchmark
@inject BenchmarkAnalysisViewModel ViewModel
@inherits NFHotel.Web.Common.CancellableComponentBase

@*
    The analysis view of one open run, laid out like the notebook of the benchmark repository: performance per model and
    phase, deterministic task outcomes, the answers of the models side by side, memory use, and the export. Only markup
    and binding; the figures come from BenchmarkResultAnalysis.

    Not in this view: the figures that the benchmark service calculated from the dataset (cancellation rates of the
    data). The service does not deliver them yet, so the cards show n/a next to the rates of the models.
*@

@{
    var selected = BenchmarkResultAnalysis.Select(Run.Results, ViewModel.Workload);
    var phases = BenchmarkResultAnalysis.Phases(selected);
    var outcomes = BenchmarkResultAnalysis.TaskOutcomes(selected);
    var resources = BenchmarkResultAnalysis.Resources(Run.Results);
    var hotel = BenchmarkResultAnalysis.Select(Run.Results, BenchmarkWorkload.Hotel);
}

<section class="card" aria-labelledby="analysis-performance">
    <CardHead Id="analysis-performance"
              Title="Performance"
              Hint="Cold is the first request of a model in its run (it may include loading the model); warm is every later request."
              Icon="trend">
        <Actions>
            <label class="inline-select">
                <span>Workload</span>
                <select id="analysis-workload" class="field-input" @bind="ViewModel.Workload" @bind:after="StateHasChanged">
                    <option value="@BenchmarkWorkload.Hotel">Hotel analysis</option>
                    <option value="@BenchmarkWorkload.Deterministic">Deterministic tasks</option>
                    <option value="@BenchmarkWorkload.Both">Both</option>
                </select>
            </label>
        </Actions>
    </CardHead>

    <div class="card-body stack-lg">
    @if (phases.Count == 0)
    {
        <p class="muted">No request of this workload finished without an error.</p>
    }
    else
    {
        <div class="chart-grid">
            <GroupedBarChart Title="First token (s)" AxisTitle="seconds, lower is faster" SeriesNames="PhaseNames"
                             Groups="PhaseGroups(phases, stats => stats.FirstTokenSeconds)" />
            <GroupedBarChart Title="Total time (s)" AxisTitle="seconds, lower is faster" SeriesNames="PhaseNames"
                             Groups="PhaseGroups(phases, stats => stats.TotalSeconds)" />
            <GroupedBarChart Title="Tokens per second" AxisTitle="tokens/s, higher is faster" SeriesNames="PhaseNames"
                             Groups="PhaseGroups(phases, stats => stats.TokensPerSecond)" />
        </div>

        <div class="table-wrap">
            <table class="table">
                <caption>Mean per model and phase</caption>
                <thead>
                    <tr>
                        <th scope="col">Model</th>
                        <th scope="col">Phase</th>
                        <th scope="col" class="numeric">First token (s)</th>
                        <th scope="col" class="numeric">Total (s)</th>
                        <th scope="col" class="numeric">Tokens</th>
                        <th scope="col" class="numeric">Tokens/s</th>
                        <th scope="col" class="numeric">Requests</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stats in phases)
                    {
                        <tr>
                            <td>@stats.Model</td>
                            <td>@stats.Phase</td>
                            <td class="numeric">@Number(stats.FirstTokenSeconds)</td>
                            <td class="numeric">@Number(stats.TotalSeconds)</td>
                            <td class="numeric">@Number(stats.CompletionTokens)</td>
                            <td class="numeric">@Number(stats.TokensPerSecond)</td>
                            <td class="numeric">@stats.Requests</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
</section>

@if (outcomes.Count > 0)
{
    var tasks = outcomes.Select(outcome => outcome.TaskId).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray();
    var models = outcomes.Select(outcome => outcome.Model).Distinct(StringComparer.Ordinal).ToArray();
    <section class="card" aria-labelledby="analysis-outcomes">
        <CardHead Id="analysis-outcomes" Title="Deterministic task outcomes" Hint="Passed runs out of graded runs, per model and task." Icon="check" Tint="ok" />
        <div class="table-wrap">
            <table class="table">
                <caption>Passed runs out of graded runs, per model and task</caption>
                <thead>
                    <tr>
                        <th scope="col">Model</th>
                        @foreach (var task in tasks)
                        {
                            <th scope="col">@task</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var model in models)
                    {
                        <tr>
                            <th scope="row">@model</th>
                            @foreach (var task in tasks)
                            {
                                var outcome = outcomes.FirstOrDefault(item => item.Model == model && item.TaskId == task);
                                @if (outcome is null)
                                {
                                    <td>—</td>
                                }
                                else
                                {
                                    <td>
                                        <span class="outcome @(outcome.AllPassed ? "outcome-pass" : "outcome-fail")">@(outcome.AllPassed ? "pass" : "fail") (@outcome.Passed/@outcome.Total)</span>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (hotel.Count > 0)
{
    <section class="card" aria-labelledby="analysis-answers">
        <CardHead Id="analysis-answers"
                  Title="LLM analysis comparison"
                  Hint="@CompareHint"
                  Icon="sparkle"
                  Tint="amber" />
        <div class="card-body stack">
        <ErrorAlert Errors="ViewModel.Errors" />
        <div class="table-wrap">
            <table class="table">
                <caption>Answers to the hotel cancellation analysis</caption>
                <thead>
                    <tr>
                        <th scope="col">Compare</th>
                        <th scope="col">Model</th>
                        <th scope="col" class="numeric">Run</th>
                        <th scope="col">Phase</th>
                        <th scope="col" class="numeric">First token (s)</th>
                        <th scope="col" class="numeric">Total (s)</th>
                        <th scope="col" class="numeric">Tokens</th>
                        <th scope="col" class="numeric">Tokens/s</th>
                        <th scope="col">Valid</th>
                        <th scope="col">Finish</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in hotel)
                    {
                        var id = result.BenchmarkResultId;
                        <tr>
                            <td>
                                <input type="checkbox"
                                       aria-label="Compare the answer of @result.Model, run @(result.RunNumber + 1)"
                                       checked="@ViewModel.IsCompared(id)"
                                       disabled="@ViewModel.IsBusy"
                                       @onchange="() => ToggleAsync(id)" />
                            </td>
                            <td>@result.Model</td>
                            <td class="numeric">@(result.RunNumber + 1)</td>
                            <td>@(result.Cold ? "cold" : "warm")</td>
                            <td class="numeric">@Number(result.TimeToFirstTokenSeconds)</td>
                            <td class="numeric">@Number(result.TotalSeconds)</td>
                            <td class="numeric">@result.CompletionTokens</td>
                            <td class="numeric">@Number(result.TokensPerSecond)</td>
                            <td><span class="@ValidClass(result)">@(result.HasError ? "error" : result.ResponseValid is { } valid ? (valid ? "yes" : "no") : "—")</span></td>
                            <td>@(result.FinishReason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewModel.Compared.Count > 0)
        {
            <p class="muted">Compare up to @BenchmarkAnalysisViewModel.MaxCompared answers; a new choice replaces the oldest.</p>
            <div class="compare-cards">
                @foreach (var id in ViewModel.Compared)
                {
                    var result = hotel.FirstOrDefault(item => item.BenchmarkResultId == id);
                    @if (result is not null && ViewModel.Outputs.TryGetValue(id, out var output))
                    {
                        <AnswerCard Result="result" Output="output" />
                    }
                }
            </div>
        }
        </div>
    </section>
}

@if (resources.Any(usage => usage.RamPeakMb is not null || usage.VramPeakMb is not null))
{
    <section class="card" aria-labelledby="analysis-resources">
        <CardHead Id="analysis-resources"
                  Title="Resource usage"
                  Hint="Memory is what the whole machine had in use, sampled about four times a second, not what the model alone used. The mean over the requests of a model."
                  Icon="cpu"
                  Tint="slate" />
        <div class="card-body">
        <div class="chart-grid">
            <GroupedBarChart Title="System memory (MB)" AxisTitle="MB, mean over the requests" SeriesNames="MomentNames" ValueFormat="#,0"
                             Groups="MomentGroups(resources, usage => usage.RamBeforeMb, usage => usage.RamAfterMb, usage => usage.RamPeakMb)" />
            @if (resources.Any(usage => usage.VramPeakMb is not null))
            {
                <GroupedBarChart Title="GPU memory (MB)" AxisTitle="MB, mean over the requests" SeriesNames="MomentNames" ValueFormat="#,0"
                                 Groups="MomentGroups(resources, usage => usage.VramBeforeMb, usage => usage.VramAfterMb, usage => usage.VramPeakMb)" />
            }
            else
            {
                <p class="muted chart-empty">GPU memory was not measured (no NVIDIA GPU, or nvidia-smi was not found).</p>
            }
        </div>
        </div>
    </section>
}

<section class="card" aria-labelledby="analysis-export">
    <CardHead Id="analysis-export" Title="Export" Hint="The rows of this run without the answer texts, which are read one at a time." Icon="list" Tint="slate">
        <Actions>
            <a class="btn btn-secondary btn-sm" download="benchmark-results-@(Run.Header.RunId).csv"
               href="data:text/csv;charset=utf-8,@Uri.EscapeDataString(BenchmarkExport.ToCsv(Run.Results))">Download CSV</a>
            <a class="btn btn-secondary btn-sm" download="benchmark-results-@(Run.Header.RunId).json"
               href="data:application/json;charset=utf-8,@Uri.EscapeDataString(BenchmarkExport.ToJson(Run.Results))">Download JSON</a>
        </Actions>
    </CardHead>
</section>
