@page "/admin/market-analysis"
@layout NFHotel.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = StaffPolicies.MarketAnalysisView)]
@rendermode InteractiveServer
@inherits NFHotel.Web.Common.CancellableComponentBase
@using System.Globalization
@using NFHotel.Application.Dto.MarketAnalysis
@using NFHotel.Web.Features.Admin.MarketAnalysis
@inject MarketAnalysisViewModel ViewModel

@*
    The market analysis report (MIL-026, US-001.01). Only markup and binding.

    The page shows the report that was stored last: the AI analysis next to the charts of the market data. A Manager can
    start a new run; a run takes minutes, so the page then asks for its state every few seconds and shows the new report
    when the API has stored it. Without a stored run the page says so instead of showing an empty page.
*@

<PageTitle>Market analysis — administration</PageTitle>

<div class="stack-lg">
    <PageHeader Title="Market analysis"
                Subtitle="The bookings of the hotel, analysed by the markets API, with an executive summary written by a local AI model." />

    <ErrorAlert Errors="ViewModel.Errors" />

    <AuthorizeView Policy="@StaffPolicies.MarketAnalysisStart">
        <section class="card" aria-labelledby="run-start">
            <CardHead Id="run-start"
                      Title="New analysis"
                      Hint="Choose the period of the bookings by arrival date. Leave a date empty for no limit."
                      Icon="sparkle" />
            <div class="card-body stack">
                <div class="analysis-run">
                    <FormField Label="From arrival date" For="analysis-from">
                        <input id="analysis-from" class="field-input" type="date" disabled="@(!ViewModel.CanStart)" @bind="ViewModel.From" />
                    </FormField>
                    <FormField Label="To arrival date" For="analysis-to">
                        <input id="analysis-to" class="field-input" type="date" disabled="@(!ViewModel.CanStart)" @bind="ViewModel.To" />
                    </FormField>
                    <div class="segmented" role="group" aria-label="Quick choice of the period">
                        <button type="button" class="segmented-item" disabled="@(!ViewModel.CanStart)" @onclick="() => ViewModel.UseLastYears(3)">Last 3 years</button>
                        <button type="button" class="segmented-item" disabled="@(!ViewModel.CanStart)" @onclick="() => ViewModel.UseLastYears(1)">Last year</button>
                        <button type="button" class="segmented-item" disabled="@(!ViewModel.CanStart)" @onclick="ViewModel.UseAllBookings">All bookings</button>
                    </div>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(!ViewModel.CanStart)"
                            @onclick="StartAsync">
                        <AdminIcon Name="sparkle" />Start a new analysis
                    </button>
                </div>
                <p class="field-hint">A run takes minutes, and the report below stays as it is until the new run has finished.</p>

                @if (ViewModel.CurrentRun is { } run)
                {
                    <div role="status" aria-live="polite">
                        @if (ViewModel.LastRunFailed)
                        {
                            <AlertBox Kind="AlertKind.Error" Message="@($"The analysis failed. {ViewModel.FailureText}")" />
                        }
                        else if (run.State == MarketAnalysisRunStates.Completed)
                        {
                            <AlertBox Kind="AlertKind.Ok" Message="The analysis is done and the report below is the new one." />
                        }
                        else
                        {
                            <p class="run-state"><span class="spinner" aria-hidden="true"></span><strong>@run.State</strong>@SinceText(run)</p>
                        }
                    </div>
                }
            </div>
        </section>
    </AuthorizeView>

    @if (!ViewModel.IsLoaded)
    {
        <LoadingSkeleton Rows="4" />
    }
    else if (ViewModel.HasNoReport)
    {
        <EmptyState Title="No market analysis yet"
                    Description="No analysis has been run. A Manager can start the first one above." />
    }
    else if (ViewModel.Report is { } report)
    {
        <div class="report-meta">
            <AdminIcon Name="clock" />
            <span>Run of @Time(report.StartedAt), finished @Time(report.FinishedAt).</span>
            @if (!string.IsNullOrWhiteSpace(report.Model))
            {
                <span class="report-model"><AdminIcon Name="cpu" Class="icon-sm" />Analysis by @report.Model.</span>
            }
        </div>

        <div class="report-layout">
            <MarketAnalysisContents HasFigures="report.Content.Figures.Count > 0"
                                    HasOverall="ViewModel.Overall is not null"
                                    HasForecast="ViewModel.Forecast is not null"
                                    Sections="ViewModel.Sections" />

            <div class="report-main stack-lg">
                @if (report.Content.Figures.Count > 0)
                {
                    <section aria-labelledby="figures-title">
                        <h2 class="report-kicker" id="figures-title">Key figures</h2>
                        <div class="kpi-grid">
                            @foreach (var (figure, index) in report.Content.Figures.Select((figure, index) => (figure, index)))
                            {
                                <KpiTile Label="@figure.Label"
                                         Value="@figure.Value.ToString("#,0.##", CultureInfo.InvariantCulture)"
                                         Detail="@figure.Unit"
                                         Icon="@(index == 0 ? "list" : "info")"
                                         Tint="@(index == 0 ? "teal" : "slate")" />
                            }
                        </div>
                    </section>
                }

                @if (ViewModel.Overall is { } overall)
                {
                    <MarketAnalysisInterpretation Overall="overall" />
                }

                @foreach (var view in ViewModel.Sections)
                {
                    var section = view.Section;
                    var headingId = $"analysis-{section.Id}";
                    <section class="card" aria-labelledby="@headingId">
                        <CardHead Id="@headingId" Title="@section.Title" Icon="chart" Tint="slate" />
                        <div class="card-body stack-lg">
                            @if (section.Status != "available")
                            {
                                <p class="muted">This analysis could not be made@(string.IsNullOrWhiteSpace(section.Reason) ? "." : $": {section.Reason}")</p>
                            }
                            else
                            {
                                @if (section.Insight is { } insight)
                                {
                                    <div class="insight stack-sm" role="region" aria-label="AI executive summary of @section.Title">
                                        <div class="insight-head">
                                            <span class="tint tint-amber insight-icon" aria-hidden="true"><AdminIcon Name="sparkle" /></span>
                                            <h3 class="subtitle-small">AI executive summary</h3>
                                            <span class="chart-ai-label">AI-generated</span>
                                        </div>
                                        @if (insight.Status == "available" && !string.IsNullOrWhiteSpace(insight.ExecutiveSummary))
                                        {
                                            <MarkdownText Text="@insight.ExecutiveSummary" />
                                            <p class="field-hint">Written by an AI model. It is a hypothesis to check, not a forecast.</p>
                                            @if (insight.Suggestions.Count > 0)
                                            {
                                                <h4 class="insight-subhead">Suggestions</h4>
                                                <ul class="suggestions">
                                                    @foreach (var suggestion in insight.Suggestions)
                                                    {
                                                        <li>
                                                            <AdminIcon Name="arrow" Class="icon-sm" />
                                                            <div>
                                                                <MarkdownText Text="@suggestion.Suggestion" />
                                                                <MarkdownText Text="@($"Evidence: {suggestion.Evidence} ({suggestion.SampleSize} bookings)")" CssClass="markdown-text evidence" />
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        }
                                        else
                                        {
                                            <p class="muted">No AI summary for this analysis@(string.IsNullOrWhiteSpace(insight.Reason) ? "." : $": {insight.Reason}")</p>
                                        }
                                    </div>
                                }

                                @if (section.RoomRevenue is { } roomRevenue)
                                {
                                    <RoomRevenuePanel Revenue="roomRevenue" Section="section" />
                                }

                                @if (!view.HasCharts && section.RoomRevenue is null)
                                {
                                    <p class="muted">This analysis has no chart data.</p>
                                }
                                else if (view.HasCharts)
                                {
                                    <div class="chart-grid">
                                        @foreach (var chart in view.Charts)
                                        {
                                            <MarketChart Series="chart.Series" Section="section" />
                                        }
                                        @foreach (var matrix in view.Matrices)
                                        {
                                            <div class="chart-block chart-wide">
                                                <CorrelationHeatmap Matrix="matrix" />
                                                <ChartCaption Model="ChartCaptionText.ForMatrix(matrix, section)" />
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </section>
                }

                @if (ViewModel.Forecast is { } forecast)
                {
                    <MarketAnalysisForecast Forecast="forecast" Charts="ViewModel.ForecastCharts" />
                }
            </div>
        </div>
    }
</div>

