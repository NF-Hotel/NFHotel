@using NFHotel.Web.Features.Admin.Shared

@*
    The room revenue of the room value analysis (MIL-026 task 25): the total, the mean per booking and the bookings left out as tiles,
    and the revenue of each month of arrival as columns. The caption says what the figure is not: before taxes, fees, discounts and
    extras, and the currency is not known.
*@

<div class="stack-sm" role="region" aria-label="Room revenue">
    <h3 class="subtitle-small">Room revenue</h3>
    <div class="figure-grid">
        <FigureTile Title="Total room revenue" Value="Revenue.Total" Label="@($"{Revenue.RecordsWithPrice:N0} bookings that are not cancelled, in {Revenue.Unit}")" />
        @if (Revenue.Mean is { } mean)
        {
            <FigureTile Title="Mean per booking" Value="mean" Label="@($"in {Revenue.Unit}")" />
        }
        <FigureTile Title="Bookings left out" Value="Revenue.RecordsWithoutPrice" Label="no price" />
    </div>
    <p class="field-hint">@Caption</p>
    @if (!string.IsNullOrWhiteSpace(Revenue.Limitation))
    {
        <p class="field-hint">@Revenue.Limitation</p>
    }
    @if (Revenue.Monthly.Count > 0)
    {
        <div class="chart-block chart-wide">
            <ColumnChart Title="@MonthlyTitle" Unit="@Revenue.Unit" Points="Revenue.Monthly" />
            <ChartCaption Model="MonthlyCaption" />
        </div>
    }
</div>

