@using NFHotel.Application.Dto.MarketAnalysis
@using NFHotel.Web.Features.Admin.Shared

@*
    The overall interpretation of the market analysis report (MIL-026 task 24): the Markdown text that reads all analyses together,
    with a label of where it comes from. An AI text is labelled AI-generated; a text that the service builds from the largest finding
    of each analysis says that it is calculated and not written by an AI. The recommendations of an AI text are listed under it.
*@

<section class="card card-feature" aria-labelledby="@SectionId">
    <CardHead Id="@SectionId" Title="Overall interpretation" Icon="sparkle" Tint="amber">
        <Actions>
            @if (Overall.IsAi)
            {
                <span class="chart-ai-label">@AiLabel</span>
            }
            else
            {
                <span class="chart-ai-label is-calculated">@FiguresLabel</span>
            }
        </Actions>
    </CardHead>
    <div class="card-body stack">
        @if (Overall.IsAi)
        {
            <p class="field-hint">@AiNote</p>
        }
        <div class="lead-text">
            <MarkdownText Text="@Overall.Text" />
        </div>
        @if (!string.IsNullOrWhiteSpace(Overall.Evidence))
        {
            <MarkdownText Text="@($"Evidence: {Overall.Evidence}")" CssClass="markdown-text evidence" />
        }
        @if (Overall.Recommendations.Count > 0)
        {
            <h3 class="insight-subhead">Recommendations</h3>
            <ul class="suggestions">
                @foreach (MarketAnalysisSuggestionDto recommendation in Overall.Recommendations)
                {
                    <li>
                        <AdminIcon Name="arrow" Class="icon-sm" />
                        <div>
                            <MarkdownText Text="@recommendation.Suggestion" />
                            <MarkdownText Text="@($"Evidence: {recommendation.Evidence} ({recommendation.SampleSize} bookings)")" CssClass="markdown-text evidence" />
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    /// <summary>The id of the heading, which the contents list links to.</summary>
    public const string SectionId = "overall-title";

    /// <summary>The label of a text that an AI model wrote.</summary>
    public const string AiLabel = "AI-generated";

    /// <summary>The note under the label of an AI text.</summary>
    public const string AiNote = "Written by an AI model from the figures of this report. It is a hypothesis to check, not a forecast.";

    /// <summary>The label of a text that the service calculated from the figures.</summary>
    public const string FiguresLabel = "Calculated from the figures, not by an AI";

    /// <summary>The overall interpretation to show.</summary>
    [Parameter, EditorRequired]
    public MarketAnalysisOverallDto Overall { get; set; } = new(string.Empty, string.Empty, null, string.Empty, null, []);
}
