@using NFHotel.Web.Features.Admin.MarketAnalysis

@*
    The contents of the market analysis report (MIL-026): a link to the key figures, the overall interpretation, each analysis and the forecast.
    A link carries the page path because the base href of the app would send a bare fragment to the start page.
*@
<nav class="report-toc" aria-labelledby="contents-title">
    <h2 class="report-kicker" id="contents-title">Contents</h2>
    <ol class="toc">
        @if (HasFigures)
        {
            <li><a href="@($"{PagePath}#figures-title")">Key figures</a></li>
        }
        @if (HasOverall)
        {
            <li><a href="@($"{PagePath}#{MarketAnalysisInterpretation.SectionId}")">Overall interpretation</a></li>
        }
        @foreach (MarketAnalysisSectionView entry in Sections)
        {
            <li><a href="@($"{PagePath}#analysis-{entry.Section.Id}")">@entry.Section.Title</a></li>
        }
        @if (HasForecast)
        {
            <li><a href="@($"{PagePath}#{MarketAnalysisForecast.SectionId}")">Forecast</a></li>
        }
    </ol>
</nav>

