@using NFHotel.Application.Dto.MarketAnalysis
@using NFHotel.Web.Features.Admin.Shared

@*
    The forecast of the next months (MIL-026 task 25): a line chart for each measure with the band of the history, the months of
    history it rests on, and a note when the history is too short. The captions say that the service calculated it and not an AI model.
*@

<section class="card" aria-labelledby="@SectionId">
    <CardHead Id="@SectionId" Title="Forecast" Icon="trend" Hint="@HistoryText(Forecast)">
        <Actions>
            <span class="chart-ai-label is-calculated">@CalculatedLabel</span>
        </Actions>
    </CardHead>
    <div class="card-body stack-lg">
        @if (Forecast.HistoryTooShort)
        {
            <div role="note" class="chart-observation">
                <p><strong>Short history.</strong> @TooShortText(Forecast)</p>
            </div>
        }
        @if (Charts.Count == 0)
        {
            <p class="muted">No month could be forecast.</p>
        }
        else
        {
            <div class="chart-grid">
                @foreach (MarketAnalysisForecastChart chart in Charts)
                {
                    <div class="chart-block">
                        <LineChart Title="@chart.Title" Unit="@chart.Unit" Points="chart.Points" BandLow="chart.Low" BandHigh="chart.High" />
                        <p class="field-hint">@chart.Caption</p>
                    </div>
                }
            </div>
        }
        @if (Forecast.Limitations.Count > 0 || !string.IsNullOrWhiteSpace(Forecast.Formula))
        {
            <details class="about">
                <summary>About the forecast</summary>
                @if (Forecast.Limitations.Count > 0)
                {
                    <div>
                        <strong>What it cannot say.</strong>
                        <ul class="chart-caption-limits">
                            @foreach (string limit in Forecast.Limitations)
                            {
                                <li>@limit</li>
                            }
                        </ul>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Forecast.Formula))
                {
                    <p><strong>How the forecast is calculated.</strong> @Forecast.Formula</p>
                }
            </details>
        }
    </div>
</section>

@code {
    /// <summary>The id of the heading, which the contents list links to.</summary>
    public const string SectionId = "forecast-title";

    /// <summary>The label that says who made the forecast.</summary>
    public const string CalculatedLabel = "Calculated by the service, not by an AI";

    /// <summary>The forecast to show.</summary>
    [Parameter, EditorRequired]
    public MarketAnalysisForecastDto Forecast { get; set; } = new(string.Empty, [], 0, 0, false, 0, []);

    /// <summary>The charts of the forecast, one for each measure that has months.</summary>
    [Parameter]
    public IReadOnlyList<MarketAnalysisForecastChart> Charts { get; set; } = [];

    private static string HistoryText(MarketAnalysisForecastDto forecast) =>
        $"It rests on {forecast.HistoryMonths} complete months of history and looks {forecast.HorizonMonths} months ahead. "
        + "It repeats the seasonal pattern of the history; it is not a promise.";

    private static string TooShortText(MarketAnalysisForecastDto forecast) =>
        $"The history has {forecast.HistoryMonths} complete months, fewer than the {forecast.MinimumHistoryMonths} months that the service wants, so the pattern may not be reliable.";
}
