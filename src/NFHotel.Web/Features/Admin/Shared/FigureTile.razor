@*
    One figure as a tile: the title of the series, the figure in large type with its unit, and what it is the figure of. A single
    figure has nothing to be compared with, so it is not drawn as a chart.
*@

<figure class="chart figure-tile">
    <figcaption class="chart-title">@Title</figcaption>
    <p class="figure-tile-value"><strong>@ChartFormat.Value(Value, Unit)</strong></p>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <p class="muted">@Label@(SmallSample ? " (few bookings)" : string.Empty)</p>
    }
</figure>

