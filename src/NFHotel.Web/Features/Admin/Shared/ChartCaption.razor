@*
    The caption under a chart: what it shows, why this kind of chart, what it cannot say, and the AI observation of the chart,
    labelled as AI-generated. A chart without an observation says so in a short line and never shows an empty box.
*@

<div class="chart-caption stack-sm">
    <p><strong>What it shows.</strong> @Model.What</p>
    @if (Model.Observation is { } observation)
    {
        <div class="chart-observation" role="note">
            <p><strong>AI observation</strong> <span class="chart-ai-label">AI-generated</span></p>
            <MarkdownText Text="@observation.Text" />
            @if (!string.IsNullOrWhiteSpace(observation.Evidence))
            {
                <MarkdownText Text="@($"Evidence: {observation.Evidence}")" CssClass="markdown-text evidence" />
            }
        </div>
    }
    else
    {
        <p class="field-hint">@Model.NoObservation</p>
    }
    <details class="about">
        <summary>About this chart</summary>
        <p><strong>Why this chart.</strong> @Model.Why</p>
        <div>
            <strong>What it cannot say.</strong>
            <ul class="chart-caption-limits">
                @foreach (var limit in Model.Limits)
                {
                    <li>@limit</li>
                }
            </ul>
        </div>
        @if (Model.Formula is { } formula)
        {
            <p><strong>How the figures are calculated.</strong> @formula</p>
        }
    </details>
</div>

