@using System.Globalization
@using System.Text

@*
    The correlation matrix of an analysis as a square heat map drawn as inline SVG (MIL-026 task 21). The scale is diverging from
    -1 to +1: blue for a negative correlation, near white for none, red for a positive one. Every cell carries its value with two
    decimals (a dash where the pair could not be calculated), so the colour is not the only cue. The names of the fields are on
    both axes, turned on the top axis and shortened when long (the full name is a tooltip). A legend shows the scale, and a hidden
    table gives the values to screen readers.
*@

@if (Matrix.Fields.Count == 0)
{
    <p class="muted">@Matrix.Title: no data.</p>
}
else
{
    <figure class="chart chart-correlation">
        <figcaption class="chart-title">@Title</figcaption>
        @BuildSvg()
        <table class="visually-hidden">
            <caption>@Title</caption>
            <thead>
                <tr>
                    <th scope="col">Field</th>
                    @foreach (var field in Matrix.Fields)
                    {
                        <th scope="col">@ChartFormat.Readable(field)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var row = 0; row < Matrix.Fields.Count; row++)
                {
                    <tr>
                        <th scope="row">@ChartFormat.Readable(Matrix.Fields[row])</th>
                        @for (var column = 0; column < Matrix.Fields.Count; column++)
                        {
                            <td>@CellText(row, column, "n/a")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </figure>
}

