@*
    Confirmation before an action that cannot be undone: cancelling a booking (BR-04)
    and deleting a guest or a room.

    The panel is an embedded strip and not an overlay. A modal would require classes that
    do not exist in the design system (UI-Spec section 3 is the contract), and an overlay in Blazor
    Server stays on screen after navigation, because the DOM survives the page change. The strip
    stands instead where the row stands, and disappears when the list is fetched again.

    No logic: what is to be confirmed, and what happens afterwards, is decided by the
    viewmodel that opened the panel.
*@

<div class="alert alert-error" role="alertdialog" aria-label="@Title">
    <p><strong>@Title</strong></p>

    <p>@Message</p>

    <div class="row">
        <button type="button"
                class="btn btn-danger btn-sm"
                disabled="@IsBusy"
                @onclick="OnConfirm">
            @ConfirmLabel
        </button>

        <button type="button"
                class="btn btn-secondary btn-sm"
                disabled="@IsBusy"
                @onclick="OnCancel">
            Go back
        </button>
    </div>
</div>

@code {
    /// <summary>The heading, for example "Cancel booking FLZ-000123?".</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>The explanation of what happens if the user continues.</summary>
    [Parameter]
    [EditorRequired]
    public string Message { get; set; } = string.Empty;

    /// <summary>The text on the confirming button. Must name the action, not say "OK".</summary>
    [Parameter]
    public string ConfirmLabel { get; set; } = "Confirm";

    /// <summary>Disables both buttons while a call is in progress.</summary>
    [Parameter]
    public bool IsBusy { get; set; }

    /// <summary>Called when the user confirms.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Called when the user backs out.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }
}
