
@*
    Draws one series of the market analysis report with the chart of its kind (ChartKindSelector) and puts its caption under it.
    Only dispatch: the rule is in the selector, the drawing is in the chart components.
*@

<div class="chart-block">
    @switch (Kind)
    {
        case ChartKind.Tile:
            var only = Series.Points[0];
            <FigureTile Title="@Series.Title" Label="@only.Label" Value="only.Value" Unit="@Series.Unit" SmallSample="only.SmallSample" />
            break;
        case ChartKind.Donut:
            <DonutChart Title="@Series.Title" Unit="@Series.Unit" Points="Series.Points" />
            break;
        case ChartKind.RankedBars:
            <RankedBarChart Title="@Series.Title" Unit="@Series.Unit" Points="Series.Points" />
            break;
        case ChartKind.Columns:
            <ColumnChart Title="@Series.Title" Unit="@Series.Unit" Points="Series.Points" />
            break;
        case ChartKind.Line:
            <LineChart Title="@Series.Title" Unit="@Series.Unit" Points="Series.Points" ReferenceValue="Series.ReferenceValue" ReferenceLabel="@Series.ReferenceLabel" />
            break;
        case ChartKind.Heatmap:
            <HeatmapChart Title="@Series.Title" Unit="@Series.Unit" Points="Series.Points" />
            break;
        default:
            <GroupedBarChart Title="@Series.Title"
                             AxisTitle="@(string.IsNullOrWhiteSpace(Series.Unit) ? "value" : Series.Unit)"
                             SeriesNames="@SeriesNames"
                             Groups="@Groups" />
            break;
    }
    <ChartCaption Model="Caption" />
</div>

