@inherits SeriesChartBase
@using System.Globalization

@*
    A heat map of a long series of months, laid out as months against years, drawn as inline SVG. The value is written in every
    cell, so the colour is not the only cue; a month the series has no point for is a dash. The scale runs from the lowest to the
    highest value of the series, with a legend. Hidden table for screen readers.
*@

@if (Points.Count == 0)
{
    <p class="muted">@Title: no data.</p>
}
else
{
    <figure class="chart">
        <figcaption class="chart-title">@Title</figcaption>
        @BuildSvg()
        <ChartAlternative Title="@Title" Unit="@Unit" Points="Points" FirstColumn="Month" />
    </figure>
}

