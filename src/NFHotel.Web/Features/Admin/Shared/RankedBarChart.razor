@inherits SeriesChartBase
@using System.Globalization

@*
    Ranked bars drawn as inline SVG: many categories, the largest first, one value label at the end of each bar. Only markup and
    layout arithmetic. Hidden table for screen readers.
*@

@if (Points.Count == 0)
{
    <p class="muted">@Title: no data.</p>
}
else
{
    <figure class="chart">
        <figcaption class="chart-title">@Title</figcaption>
        @BuildSvg()
        <ChartAlternative Title="@Title" Unit="@Unit" Points="Ranked" />
    </figure>
}

