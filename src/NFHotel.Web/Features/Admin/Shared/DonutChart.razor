@inherits SeriesChartBase
@using System.Globalization
@using System.Text

@*
    A donut chart drawn as inline SVG: two to four parts of one whole. The caller (ChartKindSelector) only sends parts that add up
    to 100 %. The share of each part is written on its slice when the slice is wide enough, and always in the legend next to the
    colour, so the colour does not carry the meaning alone. Hidden table for screen readers.
*@

@if (Points.Count == 0)
{
    <p class="muted">@Title: no data.</p>
}
else
{
    <figure class="chart">
        <figcaption class="chart-title">@Title</figcaption>
        <div class="chart-donut">
            @BuildSvg()
            <ul class="chart-legend chart-legend-values">
                @for (var index = 0; index < Points.Count; index++)
                {
                    <li><span class="chart-swatch chart-series-@(index % SeriesColours)"></span>@Points[index].Label: <strong>@PointText(Points[index])</strong></li>
                }
            </ul>
        </div>
        <ChartAlternative Title="@Title" Unit="@Unit" Points="Points" />
    </figure>
}

