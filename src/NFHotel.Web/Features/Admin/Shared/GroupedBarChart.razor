@using System.Globalization
@using System.Net
@using System.Text

@*
    A horizontal grouped bar chart drawn as inline SVG: no script and no library. One group per label (for example a
    model), one bar per series (for example cold and warm). Only markup and layout arithmetic; the numbers come from the
    caller. The SVG is built as text because the Razor compiler reserves the text element, which SVG needs. Every label
    is HTML-encoded. The chart has a title and a description for screen readers, and a hidden table with the same values.
*@

@if (Groups.Count > 0)
{
    <figure class="chart">
        <figcaption class="chart-title">@Title</figcaption>
        <ul class="chart-legend" aria-hidden="true">
            @for (var index = 0; index < SeriesNames.Count; index++)
            {
                <li><span class="chart-swatch chart-series-@(index)"></span>@SeriesNames[index]</li>
            }
        </ul>
        @BuildSvg()
        <table class="visually-hidden">
            <caption>@Title</caption>
            <thead>
                <tr>
                    <th scope="col">Group</th>
                    @foreach (var name in SeriesNames)
                    {
                        <th scope="col">@name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Groups)
                {
                    <tr>
                        <th scope="row">@group.Label</th>
                        @foreach (var name in SeriesNames)
                        {
                            var value = group.Bars.FirstOrDefault(bar => bar.Series == name)?.Value;
                            <td>@(value is { } shown ? Format(shown) : "n/a")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </figure>
}

