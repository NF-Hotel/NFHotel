@page "/admin/bookings"
@layout NFHotel.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = StaffPolicies.BookingsView)]
@rendermode InteractiveServer
@inherits NFHotel.Web.Common.CancellableComponentBase
@using NFHotel.Domain.Entities
@using NFHotel.Domain.Errors
@using NFHotel.Domain.ValueObjects
@using NFHotel.Web.Features.Admin.Bookings
@inject BookingListViewModel ViewModel
@inject BookingFormViewModel Form

@*
    Booking overview with search, sorting, status filters and the actions that are legal
    on each individual booking.

    Only markup and binding. Which buttons appear in a row comes exclusively from
    BookingListItemDto.Actions (BR-22) — this file knows no status transitions, and there
    is no if statement here that guesses at a status.

    Cancellation goes through ConfirmPanel (BR-04): it is pure UI and belongs here, not in
    Application.

    The view switch in the header swaps the filter and the table for the availability calendar
    (BookingCalendar). A night picked there opens the same panel, with the dates filled in.
*@

<PageTitle>Bookings — administration</PageTitle>

<div class="stack-lg">
    <PageHeader Title="Bookings"
                Subtitle="Search, sort and move bookings through check-in and check-out. A new booking is made in a few steps in the panel.">
        <Actions>
            <div class="admin-segmented view-switch" role="group" aria-label="View">
                <button type="button"
                        class="btn"
                        aria-pressed="@ViewPressed(calendar: false)"
                        @onclick="ShowList">
                    <AdminIcon Name="list" />
                    List
                </button>

                <button type="button"
                        class="btn"
                        aria-pressed="@ViewPressed(calendar: true)"
                        @onclick="ShowCalendar">
                    <AdminIcon Name="calendar" />
                    Calendar
                </button>
            </div>

            <button type="button"
                    class="btn btn-primary"
                    disabled="@Form.IsBusy"
                    @onclick="BeginCreate">
                <AdminIcon Name="plus" />
                New booking
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(Form.SuccessMessage))
    {
        <AlertBox Kind="AlertKind.Ok" Message="@Form.SuccessMessage" />
    }

    <ErrorAlert Errors="ViewModel.Errors" />

    @if (Form.IsOpen)
    {
        @*
            The guided flow: dates → room → guest → confirm, in a panel over the list. The steps stay on the page
            as the user works down them — nothing is hidden behind a "next" button — and a done step gets a green
            number. All content sits inside <section>, as the keyboard and the tests find the buttons there.
        *@
        <div class="drawer-backdrop" @onclick="CloseForm"></div>
        <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="booking-form">
            <section class="drawer-head">
                <div>
                    <h2 class="subtitle" id="booking-form">@Form.Title</h2>
                    <p class="hint">@FlowHint</p>
                </div>
                <button type="button" class="admin-icon-btn" aria-label="Close" disabled="@Form.IsBusy" @onclick="CloseForm">
                    <AdminIcon Name="x" />
                </button>
            </section>

            <section class="drawer-body" aria-label="Booking form">
                <ErrorAlert Errors="Form.Errors" />

                <div class="@StepClass(1)">
                    <span class="step-no" aria-hidden="true">1</span>
                    <h3 class="step-title">Dates <span class="muted">The check-out day does not count as a night.</span></h3>
                    <div class="step-content">
                        <div class="field-row">
                            <FormField Label="Check-in" For="form-check-in" IsRequired="true">
                                <input id="form-check-in"
                                       type="date"
                                       class="field-input"
                                       disabled="@Form.IsBusy"
                                       @bind="Form.CheckInDate" />
                            </FormField>

                            <FormField Label="Check-out" For="form-check-out" IsRequired="true">
                                <input id="form-check-out"
                                       type="date"
                                       class="field-input"
                                       disabled="@Form.IsBusy"
                                       @bind="Form.CheckOutDate" />
                            </FormField>
                        </div>

                        <div class="row">
                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled="@Form.IsBusy"
                                    @onclick="SearchRoomsAsync">
                                <AdminIcon Name="search" />
                                Find available rooms
                            </button>
                        </div>
                    </div>
                </div>

                <div class="@StepClass(2)">
                    <span class="step-no" aria-hidden="true">2</span>
                    <h3 class="step-title">Room <span class="muted">Only rooms free for every night are offered.</span></h3>
                    <div class="step-content">
                        @if (Form.HasNoAvailableRooms)
                        {
                            <EmptyState Title="No rooms are free for those dates"
                                        Description="Every room is either taken or out of service for the dates you picked. Try another period." />
                        }
                        else if (Form.AvailableRooms.Count > 0)
                        {
                            <div class="table-wrap">
                                <table class="table table-compact">
                                    <caption>Rooms free for the whole period</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Room</th>
                                            <th scope="col" class="numeric">Floor</th>
                                            <th scope="col">Size</th>
                                            <th scope="col" class="numeric">Sleeps</th>
                                            <th scope="col" class="table-actions">Choose</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var room in Form.AvailableRooms)
                                        {
                                            <tr class="@RowClass(Form.SelectedRoomId == room.RoomId)">
                                                <td class="numeric-start"><strong>@room.RoomNumber</strong></td>
                                                <td class="numeric">@room.Floor</td>
                                                <td>@DisplayText.Describe(room.Size)</td>
                                                <td class="numeric">@room.Capacity</td>
                                                <td class="table-actions">
                                                    @if (Form.SelectedRoomId == room.RoomId)
                                                    {
                                                        <span class="badge badge-confirmed">Selected</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-secondary btn-sm"
                                                                disabled="@Form.IsBusy"
                                                                @onclick="() => Form.SelectRoom(room.RoomId)">
                                                            Choose room @room.RoomNumber
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="muted">Pick the dates and find the available rooms first.</p>
                        }
                    </div>
                </div>

                @if (Form.Mode == BookingFormMode.Create)
                {
                    <div class="@StepClass(3)">
                        <span class="step-no" aria-hidden="true">3</span>
                        <h3 class="step-title">Guest</h3>
                        <div class="step-content">
                            <div class="admin-segmented" role="group" aria-label="Choose guest type">
                                <button type="button"
                                        class="btn"
                                        aria-pressed="@GuestModePressed(BookingGuestMode.Existing)"
                                        disabled="@Form.IsBusy"
                                        @onclick="() => Form.SetGuestMode(BookingGuestMode.Existing)">
                                    Existing guest
                                </button>

                                <button type="button"
                                        class="btn"
                                        aria-pressed="@GuestModePressed(BookingGuestMode.New)"
                                        disabled="@Form.IsBusy"
                                        @onclick="() => Form.SetGuestMode(BookingGuestMode.New)">
                                    New guest
                                </button>
                            </div>

                            @if (Form.GuestMode == BookingGuestMode.Existing)
                            {
                                <div class="field-row">
                                    <FormField Label="Search guests" For="form-guest-search"
                                               Hint="Name, country or email.">
                                        <input id="form-guest-search"
                                               type="search"
                                               class="field-input"
                                               maxlength="@SearchLimits.MaxTextLength"
                                               disabled="@Form.IsBusy"
                                               @bind="Form.GuestSearchText" />
                                    </FormField>
                                </div>

                                <div class="row">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            disabled="@Form.IsBusy"
                                            @onclick="SearchGuestsAsync">
                                        <AdminIcon Name="search" />
                                        Search guests
                                    </button>
                                </div>

                                @if (Form.HasSearchedGuests && Form.Guests.Count == 0)
                                {
                                    <EmptyState Title="No guests match that search"
                                                Description="Try a different search, or create the guest as part of this booking." />
                                }
                                else if (Form.Guests.Count > 0)
                                {
                                    <div class="table-wrap">
                                        <table class="table table-compact">
                                            <caption>Guests matching the search</caption>
                                            <thead>
                                                <tr>
                                                    <th scope="col">Name</th>
                                                    <th scope="col">Email</th>
                                                    <th scope="col">Country</th>
                                                    <th scope="col" class="table-actions">Choose</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var guest in Form.Guests)
                                                {
                                                    <tr class="@RowClass(Form.SelectedGuestId == guest.GuestId)">
                                                        <td><strong>@guest.FullName</strong></td>
                                                        <td>@guest.Email</td>
                                                        <td>@guest.Country</td>
                                                        <td class="table-actions">
                                                            @if (Form.SelectedGuestId == guest.GuestId)
                                                            {
                                                                <span class="badge badge-confirmed">Selected</span>
                                                            }
                                                            else
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-secondary btn-sm"
                                                                        disabled="@Form.IsBusy"
                                                                        @onclick="() => Form.SelectGuest(guest.GuestId)">
                                                                    Choose @guest.FullName
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                            else
                            {
                                <ErrorAlert Errors="Form.GuestErrors" />

                                <div class="field-row">
                                    <FormField Label="First name" For="form-first-name" IsRequired="true">
                                        <input id="form-first-name"
                                               class="field-input"
                                               disabled="@Form.IsBusy"
                                               @bind="Form.FirstName"
                                               @bind:event="oninput"
                                               @bind:after="ValidateGuest" />
                                    </FormField>

                                    <FormField Label="Last name" For="form-last-name" IsRequired="true">
                                        <input id="form-last-name"
                                               class="field-input"
                                               disabled="@Form.IsBusy"
                                               @bind="Form.LastName"
                                               @bind:event="oninput"
                                               @bind:after="ValidateGuest" />
                                    </FormField>
                                </div>

                                <div class="field-row">
                                    <FormField Label="Email" For="form-email" IsRequired="true">
                                        <input id="form-email"
                                               type="email"
                                               class="field-input"
                                               disabled="@Form.IsBusy"
                                               @bind="Form.Email"
                                               @bind:event="oninput"
                                               @bind:after="ValidateGuest" />
                                    </FormField>

                                    <FormField Label="Phone" For="form-phone" IsRequired="true">
                                        <input id="form-phone"
                                               type="tel"
                                               class="field-input"
                                               disabled="@Form.IsBusy"
                                               @bind="Form.PhoneNumber"
                                               @bind:event="oninput"
                                               @bind:after="ValidateGuest" />
                                    </FormField>
                                </div>

                                <div class="field-row">
                                    <FormField Label="Country" For="form-country" IsRequired="true">
                                        <input id="form-country"
                                               class="field-input"
                                               disabled="@Form.IsBusy"
                                               @bind="Form.Country"
                                               @bind:event="oninput"
                                               @bind:after="ValidateGuest" />
                                    </FormField>

                                    <FormField Label="Passport number" For="form-passport" Hint="Optional. Stored encrypted; can be added at check-in.">
                                        <input id="form-passport"
                                               class="field-input"
                                               disabled="@Form.IsBusy"
                                               @bind="Form.PassportNumber"
                                               @bind:event="oninput"
                                               @bind:after="ValidateGuest" />
                                    </FormField>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>

            <section class="drawer-foot" aria-label="Save or cancel">
                <button type="button"
                        class="btn btn-ghost"
                        disabled="@Form.IsBusy"
                        @onclick="CloseForm">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        disabled="@(!Form.CanSave)"
                        @onclick="SaveAsync">
                    <AdminIcon Name="check" />
                    @SaveLabel
                </button>
            </section>
        </aside>
    }

    @if (_showCalendar)
    {
        <BookingCalendar Selected="_pickedNight" OnPickNight="BeginCreateForNightAsync" />
    }
    else
    {
        <section class="card" aria-labelledby="booking-filter">
            <h2 class="sr-only" id="booking-filter">Filter</h2>

            <div class="admin-toolbar">
                <FormField Label="From" For="period-start">
                    <input id="period-start"
                           type="date"
                           class="field-input"
                           disabled="@ViewModel.IsBusy"
                           @bind="ViewModel.PeriodStart" />
                </FormField>

                <FormField Label="To (exclusive)" For="period-end">
                    <input id="period-end"
                           type="date"
                           class="field-input"
                           disabled="@ViewModel.IsBusy"
                           @bind="ViewModel.PeriodEnd" />
                </FormField>

                <FormField Label="Guest or room number" For="search-text">
                    <input id="search-text"
                           type="search"
                           class="field-input"
                           maxlength="@SearchLimits.MaxTextLength"
                           disabled="@ViewModel.IsBusy"
                           @bind="ViewModel.SearchText" />
                </FormField>

                <FormField Label="Status" For="filter-status">
                    <select id="filter-status"
                            class="field-select"
                            disabled="@ViewModel.IsBusy"
                            @bind="ViewModel.StatusFilter"
                            @bind:after="ApplyStatusFilter">
                        <option value="">All statuses</option>
                        @foreach (var status in Statuses)
                        {
                            <option value="@status">@DisplayText.Describe(status)</option>
                        }
                    </select>
                </FormField>

                <label class="admin-toolbar-check" for="include-cancelled">
                    <input id="include-cancelled"
                           type="checkbox"
                           disabled="@ViewModel.IsBusy"
                           @bind="ViewModel.IncludeCancelled" />
                    Include cancelled
                </label>

                <div class="admin-toolbar-actions">
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@ViewModel.IsBusy"
                            @onclick="SearchAsync">
                        Search
                    </button>

                    <button type="button"
                            class="btn btn-ghost"
                            disabled="@ViewModel.IsBusy"
                            @onclick="ClearFilterAsync">
                        Clear filter
                    </button>
                </div>
            </div>
        </section>

        @if (ViewModel.BookingPendingCancellation is not null)
        {
            <ConfirmPanel Title="@CancelTitle"
                          Message="The booking is set to Cancelled and the room is freed up for those dates. The row stays in the list, but this can't be undone."
                          ConfirmLabel="Cancel booking"
                          IsBusy="ViewModel.IsBusy"
                          OnConfirm="ConfirmCancelAsync"
                          OnCancel="AbortCancel" />
        }

        @if (!ViewModel.IsLoaded)
        {
            <LoadingSkeleton Rows="8" />
        }
        else if (ViewModel.IsHiddenByStatusFilter)
        {
            <EmptyState Title="No bookings with that status"
                        Description="There are bookings in this period, but none with the status you picked.">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ShowAllStatuses">
                    Show all statuses
                </button>
            </EmptyState>
        }
        else if (ViewModel.IsEmpty)
        {
            <EmptyState Title="No bookings in this period"
                        Description="Widen the dates, clear the search field, or create the first booking.">
                <button type="button" class="btn btn-primary btn-sm" @onclick="BeginCreate">
                    New booking
                </button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearFilterAsync">
                    Clear filter
                </button>
            </EmptyState>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <caption>@ViewModel.Bookings.Count bookings in this period</caption>
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@ViewModel.AriaSortFor(BookingSortField.BookingNumber)">
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="() => SortAsync(BookingSortField.BookingNumber)">
                                    Booking
                                </button>
                            </th>
                            <th scope="col" aria-sort="@ViewModel.AriaSortFor(BookingSortField.GuestName)">
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="() => SortAsync(BookingSortField.GuestName)">
                                    Guest
                                </button>
                            </th>
                            <th scope="col" aria-sort="@ViewModel.AriaSortFor(BookingSortField.RoomNumber)">
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="() => SortAsync(BookingSortField.RoomNumber)">
                                    Room
                                </button>
                            </th>
                            <th scope="col" class="numeric-start"
                                aria-sort="@ViewModel.AriaSortFor(BookingSortField.StartDate)">
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="() => SortAsync(BookingSortField.StartDate)">
                                    Check-in
                                </button>
                            </th>
                            <th scope="col" class="numeric-start"
                                aria-sort="@ViewModel.AriaSortFor(BookingSortField.EndDate)">
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="() => SortAsync(BookingSortField.EndDate)">
                                    Check-out
                                </button>
                            </th>
                            <th scope="col" class="numeric"
                                aria-sort="@ViewModel.AriaSortFor(BookingSortField.Nights)">
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="() => SortAsync(BookingSortField.Nights)">
                                    Nights
                                </button>
                            </th>
                            <th scope="col" aria-sort="@ViewModel.AriaSortFor(BookingSortField.Status)">
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="() => SortAsync(BookingSortField.Status)">
                                    Status
                                </button>
                            </th>
                            <th scope="col" class="table-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in ViewModel.Bookings)
                        {
                            <tr>
                                <td class="numeric-start">@booking.BookingNumber</td>
                                <td class="nowrap">
                                    <strong>@booking.GuestFullName</strong>
                                    <span class="sub">@booking.GuestCountry</span>
                                </td>
                                <td class="numeric-start">@booking.RoomNumber</td>
                                <td class="numeric-start">@AdminFormat.Date(booking.StartDate)</td>
                                <td class="numeric-start">@AdminFormat.Date(booking.EndDate)</td>
                                <td class="numeric">@booking.Nights</td>
                                <td><StatusBadge BookingStatus="booking.Status" /></td>
                                <td class="table-actions">
                                    @if (booking.Actions.CanConfirm)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm"
                                                disabled="@ViewModel.IsBusy"
                                                @onclick="() => ExecuteAsync(BookingAction.Confirm, booking)">
                                            Confirm
                                        </button>
                                    }

                                    @if (booking.Actions.CanCheckIn)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm"
                                                disabled="@ViewModel.IsBusy"
                                                @onclick="() => ExecuteAsync(BookingAction.CheckIn, booking)">
                                            Check in
                                        </button>
                                    }

                                    @if (booking.Actions.CanCheckOut)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm"
                                                disabled="@ViewModel.IsBusy"
                                                @onclick="() => ExecuteAsync(BookingAction.CheckOut, booking)">
                                            Check out
                                        </button>
                                    }

                                    @if (booking.Actions.CanReschedule)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm btn-icon"
                                                title="Reschedule @booking.BookingNumber"
                                                disabled="@ViewModel.IsBusy"
                                                @onclick="() => BeginRescheduleAsync(booking)">
                                            <AdminIcon Name="calendar" /><span class="sr-only">Reschedule</span>
                                        </button>
                                    }

                                    @if (booking.Actions.CanCancel)
                                    {
                                        <button type="button" class="btn btn-danger btn-sm btn-icon"
                                                title="Cancel @booking.BookingNumber"
                                                disabled="@ViewModel.IsBusy"
                                                @onclick="() => RequestCancel(booking)">
                                            <AdminIcon Name="x" /><span class="sr-only">Cancel</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
