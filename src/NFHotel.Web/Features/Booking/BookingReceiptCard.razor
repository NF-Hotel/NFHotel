@using NFHotel.Application.Dto.Bookings
@using NFHotel.Application.Dto.Guests
@using NFHotel.Application.Dto.Rooms
@using NFHotel.Application.Dto.Holidays
@using NFHotel.Application.Errors
@using NFHotel.Application.Ports
@using NFHotel.Application.UseCases
@using NFHotel.Application.UseCases.Bookings
@using NFHotel.Application.UseCases.Guests
@using NFHotel.Application.UseCases.Rooms
@using NFHotel.Domain.Repositories

@*
    The receipt for one booking. Used both as step 4 in the flow and as the whole content
    of the bookmarkable page /booking/{bookingNumber}.

    BR-C-06 — WHY THERE IS NO NAME HERE
    There is no access control in Phase 1, so the booking number is the only key to
    the page. The format is "FLZ-" plus the id of the booking (BR-109), and FLZ-000123 is therefore
    one digit from the next guest's booking: whoever counts upwards hits on the first try.

    Therefore this component has markup only for booking number, period, number of nights, room
    and status (BR-C-05). Details.Guest carries name, email and phone — they are
    deliberately left unused, so a stranger cannot harvest personal data by guessing numbers.
    The customer loses nothing: she has just entered the details herself.

    The limitation is lifted at the earliest when Identity is in place — and only together with it.

    There is no price either. The price model does not exist in Phase 1 (BR-C-05, BR-31), and
    "Payment on arrival" is the honest answer rather than an empty field that looks like a fault.
*@

@if (Details is not null)
{
    <article class="card card-pad stack-lg">
        <div class="stack-sm">
            <span class="eyebrow">Booking number</span>
            <p class="display numeric">@Details.BookingNumber</p>
            <p class="muted">Keep this number. It is the key to this page.</p>
        </div>

        <div class="divider"></div>

        <div class="grid-3">
            <div class="stack-sm">
                <span class="eyebrow">Check-in</span>
                <p class="numeric">@PublicDateText.Long(Details.StartDate)</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Check-out</span>
                <p class="numeric">@PublicDateText.Long(Details.EndDate)</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Length of stay</span>
                <p class="numeric">@PublicDateText.Nights(Details.Nights)</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Room</span>
                <p>@RoomText</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Status</span>
                <p><StatusBadge BookingStatus="Details.Status" /></p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Price</span>
                <p>@BookingFlowViewModel.PaymentText</p>
            </div>
        </div>
    </article>
}

@code {
    /// <summary>The booking the receipt is for. No receipt is shown if it is <c>null</c>.</summary>
    [Parameter]
    [EditorRequired]
    public BookingDetailsDto? Details { get; set; }

    /// <summary>The room as the customer reads it: number, type and floor.</summary>
    private string RoomText => Details is null
        ? string.Empty
        : $"Room {Details.Room.RoomNumber} · {DisplayText.Describe(Details.Room.Size)} · {BookingFlowViewModel.DescribeFloor(Details.Room.Floor)}";
}
