@using NFHotel.Application.Dto.Bookings
@using NFHotel.Application.Dto.Guests
@using NFHotel.Application.Dto.Rooms
@using NFHotel.Application.Dto.Holidays
@using NFHotel.Application.Errors
@using NFHotel.Application.Ports
@using NFHotel.Application.UseCases
@using NFHotel.Application.UseCases.Bookings
@using NFHotel.Application.UseCases.Guests
@using NFHotel.Application.UseCases.Rooms
@using NFHotel.Domain.Repositories

@*
    Kvitteringen for én booking. Bruges både som trin 4 i flowet og som hele indholdet
    på den bogmærkbare side /booking/{bookingNumber}.

    BR-C-06 — HVORFOR DER IKKE STÅR ET NAVN HER
    Der er ingen adgangskontrol i Fase 1, så bookingnummeret er den eneste nøgle til
    siden. Formatet er "FLZ-" plus bookingens id (BR-109), og FLZ-000123 ligger derfor
    ét ciffer fra den næste gæsts booking: den der tæller opad, rammer i første forsøg.

    Derfor har denne komponent kun markup til bookingnummer, periode, antal nætter, rum
    og status (BR-C-05). Details.Guest bærer både navn, e-mail og telefon — de bliver
    bevidst stående ubrugt, så en fremmed ikke kan høste persondata ved at gætte numre.
    Kunden mister intet: hun har lige selv indtastet oplysningerne.

    Begrænsningen løftes tidligst når Identity er på plads — og kun samtidig med den.

    Der står heller ingen pris. Prismodellen findes ikke i Fase 1 (BR-C-05, BR-31), og
    "Betaling ved ankomst" er det ærlige svar frem for et tomt felt der ligner en fejl.
*@

@if (Details is not null)
{
    <article class="card card-pad stack-lg">
        <div class="stack-sm">
            <span class="eyebrow">Booking number</span>
            <p class="display numeric">@Details.BookingNumber</p>
            <p class="muted">Keep this number. It is the key to this page.</p>
        </div>

        <div class="divider"></div>

        <div class="grid-3">
            <div class="stack-sm">
                <span class="eyebrow">Check-in</span>
                <p class="numeric">@PublicDateText.Long(Details.StartDate)</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Check-out</span>
                <p class="numeric">@PublicDateText.Long(Details.EndDate)</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Length of stay</span>
                <p class="numeric">@PublicDateText.Nights(Details.Nights)</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Room</span>
                <p>@RoomText</p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Status</span>
                <p><StatusBadge BookingStatus="Details.Status" /></p>
            </div>

            <div class="stack-sm">
                <span class="eyebrow">Price</span>
                <p>@BookingFlowViewModel.PaymentText</p>
            </div>
        </div>
    </article>
}

@code {
    /// <summary>Bookingen der kvitteres for. Ingen kvittering vises hvis den er <c>null</c>.</summary>
    [Parameter]
    [EditorRequired]
    public BookingDetailsDto? Details { get; set; }

    /// <summary>Rummet som kunden læser det: nummer, type og etage.</summary>
    private string RoomText => Details is null
        ? string.Empty
        : $"Room {Details.Room.RoomNumber} · {DisplayText.Describe(Details.Room.Size)} · {BookingFlowViewModel.DescribeFloor(Details.Room.Floor)}";
}
