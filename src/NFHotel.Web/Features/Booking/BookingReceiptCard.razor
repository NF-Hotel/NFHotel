@using NFHotel.Application.Dto.Bookings
@using NFHotel.Application.Dto.Guests
@using NFHotel.Application.Dto.Rooms
@using NFHotel.Application.Dto.Holidays
@using NFHotel.Application.Errors
@using NFHotel.Application.Ports
@using NFHotel.Application.UseCases
@using NFHotel.Application.UseCases.Bookings
@using NFHotel.Application.UseCases.Guests
@using NFHotel.Application.UseCases.Rooms
@using NFHotel.Domain.Repositories

@*
    The receipt for one booking. Used both as step 4 in the flow and on the lookup page /booking once the number and
    the email have found the booking.

    BR-C-06 — WHY THERE IS NO NAME HERE
    The card takes BookingReceiptDto, which has only booking number, period, number of nights, room type and status
    (BR-C-05). There is no guest in it, so the card cannot show a name, an email or a phone number, not even by mistake.
    Before MIL-079 the card took the whole booking and left the guest fields unused, while the number alone opened the
    page: FLZ-000123 is one digit from the next guest's booking. Now the API answers the public lookup with the receipt
    only, and only for the number together with the email of the booking (MIL-079).

    There is no price either. The price model does not exist in Phase 1 (BR-C-05, BR-31), and
    "Payment on arrival" is the honest answer rather than an empty field that looks like a fault.
*@

@if (Receipt is not null)
{
    <article class="card card-pad stack pub-receipt">
        <div class="stack-sm">
            <span class="eyebrow">Booking number</span>
            <p class="pub-receipt-number numeric">@Receipt.BookingNumber</p>
            <p class="muted">Keep this number. With the email you booked with, it opens this booking again.</p>
        </div>

        <div class="divider"></div>

        <dl>
            <dt>Check-in</dt>
            <dd class="numeric">@PublicDateText.Long(Receipt.StartDate)</dd>

            <dt>Check-out</dt>
            <dd class="numeric">@PublicDateText.Long(Receipt.EndDate)</dd>

            <dt>Length of stay</dt>
            <dd class="numeric">@PublicDateText.Nights(Receipt.Nights)</dd>

            <dt>Room type</dt>
            <dd>@RoomText</dd>

            <dt>Status</dt>
            <dd><StatusBadge BookingStatus="Receipt.Status" /></dd>

            <dt>Price</dt>
            <dd>@BookingFlowViewModel.PaymentText</dd>
        </dl>
    </article>
}
