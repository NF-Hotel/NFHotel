@page "/booking/{BookingNumber}"
@rendermode InteractiveServer
@inherits NFHotel.Web.Common.CancellableComponentBase

@inject BookingReceiptViewModel ViewModel

@*
    The bookmarkable receipt. The page looks up only the booking number (BR-C-06) and shows
    only what BookingReceiptCard has markup for: number, dates, nights, room and status.

    Why the page shows no name, email, phone or passport number is explained in
    BookingReceiptCard.razor and in BookingReceiptViewModel — in short: without access control
    FLZ-000123 is guessable, and a stranger must not be able to harvest personal data by counting upwards.

    PublicLayout is the default layout (Routes.razor), so there is no @@layout line.
*@

<PageTitle>Your booking — NFHotel</PageTitle>

<div class="page-narrow stack-lg">
    <PageHeader Title="Your booking"
                Subtitle="Save or bookmark this page. The booking number is the key to it." />

    @if (!ViewModel.IsLoaded)
    {
        <LoadingSkeleton Rows="6" />
    }
    else if (ViewModel.Details is null)
    {
        <EmptyState Title="We couldn't find that booking" Description="@ViewModel.NotFoundText">
            <a class="btn btn-primary" href="/book">Book your stay</a>
            <a class="btn btn-secondary" href="/">Go to the front page</a>
        </EmptyState>

        <p class="muted">
            Check the number on your confirmation — it looks like this: FLZ-000123.
            If it still doesn't work, email help@nfhotel.com and reception will find it for you.
        </p>
    }
    else
    {
        <BookingReceiptCard Details="ViewModel.Details" />

        <div class="row">
            <a class="btn btn-secondary" href="/">Go to the front page</a>
            <a class="btn btn-ghost" href="/book">Book another stay</a>
        </div>
    }
</div>

@code {
    /// <summary>The booking number from the address, for example <c>FLZ-000123</c>.</summary>
    [Parameter]
    public string? BookingNumber { get; set; }

    /// <summary>
    /// Looks up the booking — also when only the number in the address changes.
    /// </summary>
    // PROOF ONLY, never merged (MIL-027 criterion 1): the receipt page answers 500.
    protected override Task OnParametersSetAsync() => throw new InvalidOperationException("proof: broken receipt");
}
