@page "/booking"
@page "/booking/{BookingNumber}"
@rendermode InteractiveServer
@inherits NFHotel.Web.Common.CancellableComponentBase

@inject BookingReceiptViewModel ViewModel

@*
    The guest's way back to a booking (BR-C-06, MIL-079): the booking number and the email the booking was made with
    open the receipt. Until MIL-079 the number alone did, and since the number is FLZ- plus the id of the booking
    (BR-109), anyone could count through every booking. Why the email, and why the page shows so little even with the
    right one, is explained in BookingReceiptViewModel.

    The address may carry the number (/booking/FLZ-000123), so the link on the confirmation and bookmarks from before
    MIL-079 still fill in the form. The email never goes in the address: the form sends it in the body of a request, so
    it stays out of access logs and the browser history.

    PublicLayout is the default layout (Routes.razor), so there is no @@layout line.
*@

<PageTitle>Find your booking — NFHotel</PageTitle>

<div class="pub-section">
    <div class="pub-wrap">
        <div class="pub-booking stack-lg">
            <PageHeader Title="Find your booking"
                        Subtitle="Enter your booking number and the email you booked with." />

            @if (ViewModel.Receipt is null)
            {
                <ErrorAlert Errors="ViewModel.Errors" />

                <form class="card card-pad stack" aria-label="Find your booking" @onsubmit="LookUpAsync" @onsubmit:preventDefault>
                    <div class="field-row">
                        <FormField Label="Booking number" For="booking-number" IsRequired="true"
                                   Hint="It is on your confirmation and looks like this: FLZ-000123.">
                            <input id="booking-number"
                                   class="field-input numeric"
                                   type="text"
                                   autocomplete="off"
                                   disabled="@ViewModel.IsBusy"
                                   @bind="ViewModel.BookingNumber" />
                        </FormField>

                        <FormField Label="Email" For="booking-email" IsRequired="true"
                                   Hint="The email you booked with.">
                            <input id="booking-email"
                                   class="field-input"
                                   type="email"
                                   autocomplete="email"
                                   disabled="@ViewModel.IsBusy"
                                   @bind="ViewModel.Email" />
                        </FormField>
                    </div>

                    <div class="row">
                        <button type="submit" class="btn btn-primary" disabled="@ViewModel.IsBusy">
                            Show my booking
                        </button>
                    </div>
                </form>

                <p class="muted">
                    If it still doesn't work, email help@nfhotel.com and reception will find the booking for you.
                </p>
            }
            else
            {
                <BookingReceiptCard Receipt="ViewModel.Receipt" />

                <div class="row">
                    <a class="btn btn-secondary" href="/">Go to the front page</a>
                    <a class="btn btn-ghost" href="/book">Book another stay</a>
                </div>
            }
        </div>
    </div>
</div>
