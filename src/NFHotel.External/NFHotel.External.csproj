<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.External holds the adapters that are not the database: the hotel clock and the typed
    HttpClient of the holiday calendar (ADR-0004). The web application uses it and holds no
    database code, so it can neither reference Infrastructure nor EF Core nor Npgsql.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- PROOF ONLY, never merged (MIL-022 criterion 1): a package with a known critical vulnerability, CVE-2021-26701. -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
  </ItemGroup>

</Project>
