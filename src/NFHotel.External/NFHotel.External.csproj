<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.External holds the adapters that are not the database: the hotel clock, the typed
    HttpClient of the holiday calendar (ADR-0004), and the export of the metrics to the
    monitoring (MIL-034). The web application uses it and holds no
    database code, so it can neither reference Infrastructure nor EF Core nor Npgsql.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <!-- The metrics of the hosts, pushed over OTLP to Alloy (MIL-034, ADR-0023). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>

</Project>
