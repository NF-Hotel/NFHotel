<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.Infrastructure is the ONLY project that knows EF Core and Npgsql
    (Architecture.md section 2). Application must not have a single PackageReference.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />

    <!--
      Explicit and pinned: EFCore.NamingConventions 9.0.0 pulls Relational 9.0.1, while
      the Npgsql provider pulls 9.0.4. Without this line the projects that reference
      Infrastructure inherit the lowest version and build with MSB3277 warnings.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />

    <!--
      compile-assets is switched on on purpose: HotelDbContextFactory implements
      IDesignTimeDbContextFactory<T>, which is only in the Design package. Without it the
      migration cannot be generated, because HotelDbContext has a dependency beyond
      DbContextOptions (IStringEncryptor, B-09). PrivateAssets=all sikrer stadig at
      the package does not flow on to Web or to the test projects.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />

    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />

    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
