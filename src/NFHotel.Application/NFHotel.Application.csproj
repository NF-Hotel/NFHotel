<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.Application holds the use cases and the business logic (B-10).
    One project reference: Domain. ZERO NuGet packages: not EF Core, Npgsql or ASP.NET
    (Architecture.md section 2). If a <PackageReference> is ever added here, the
    dependency direction is broken, and the architecture test in Application.Tests must catch it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Domain\NFHotel.Domain.csproj" />
  </ItemGroup>

</Project>
