<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.ApiClient implements the use-case interfaces of the Application layer over HTTP (ADR-0004).
    The web application references it instead of Infrastructure, so it holds an API address and a
    token and neither a database login nor EF Core nor Npgsql.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NFHotel.Api.Contracts\NFHotel.Api.Contracts.csproj" />
    <ProjectReference Include="..\NFHotel.Application\NFHotel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

</Project>
