<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.Api.Contracts is what the API and its client agree on: the routes, the response
    envelope, the authentication header and the JSON settings (ADR-0004). It references nothing,
    so neither side can reach the other through it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
