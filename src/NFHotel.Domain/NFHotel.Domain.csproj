<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.Domain er kernen: nul projektreferencer, nul NuGet-pakker.
    Bliver der nogensinde tilføjet en <PackageReference> eller <ProjectReference> her,
    er Clean Architecture-afhængighedsretningen brudt (Architecture.md afsnit 2).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
