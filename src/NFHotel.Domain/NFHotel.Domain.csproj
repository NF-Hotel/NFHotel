<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NFHotel.Domain is the core: no project references and no NuGet packages.
    If a <PackageReference> or a <ProjectReference> is ever added here,
    the Clean Architecture dependency direction is broken (Architecture.md section 2).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
