# Proxmox VE credentials for the throwaway-container integration tests.
# Copy to pve.env (git-ignored) and fill in. Never commit pve.env.
#
# Use an API token with read-only rights (role PVEAuditor on path /),
# so the tests can never change anything on the server.
# Token format used by the tests: PVEAPIToken=<ID>=<SECRET>

# Host name or IP of the Proxmox VE server, without scheme or port.
PVE_HOST=pve.example.local
# API port (default 8006).
PVE_PORT=8006
# Node name as shown in the Proxmox tree, e.g. pve.
PVE_NODE=pve
# Token ID in the form user@realm!tokenname, e.g. tester@pve!ci.
PVE_API_TOKEN_ID=tester@pve!ci
# Token secret (UUID). Create it with "Privilege Separation" enabled.
PVE_API_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# true to verify the server TLS certificate; false for a self-signed one.
PVE_VERIFY_TLS=false
# Seconds before a request is abandoned, so a run never hangs.
PVE_TIMEOUT_SECONDS=15
