<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-memory repositories, a fake clock and a fake unit of work that the service tests and the API
    tests share, so a service can run without a database in more than one test project.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NFHotel.Application\NFHotel.Application.csproj" />
  </ItemGroup>

</Project>
