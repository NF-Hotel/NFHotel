# Settings for scripts/deploy.sh. Copy to deploy.env (git-ignored).
# Values are plain text: do not quote them.

# The Proxmox node, as user@host for ssh (key login). Required.
PVE_SSH=root@pve.example.com
# Development instead: the name of a local Docker container running Proxmox VE
# (set it and leave PVE_SSH empty). The VM is reached through that container, with a
# development key the script creates. Use VM_STORAGE=local for such a node.
PVE_CONTAINER=

# The virtual machine that runs every container (ADR-0003).
VM_NAME=nfhotel-services
# Leave VM_ID empty to take the next free id; set it to adopt an existing VM.
VM_ID=
VM_CORES=4
# 12 GiB.
VM_MEMORY=12288
VM_DISK=60
VM_STORAGE=local-lvm
VM_SNIPPETS=local
VM_BRIDGE=vmbr0
# Public key installed for the VM user nfhotel; the private key must be in your ssh agent
# or ~/.ssh.
SSH_KEY_FILE=~/.ssh/id_ed25519.pub
# Set when the node cannot report the VM address through the guest agent.
VM_IP=

# Without --local: this repository (the compose files and scripts) and the NFHotel
# application the VM builds from (ADR-0012), each with its branch or tag.
REPO_URL=https://github.com/NF-Hotel/DevOps.git
REPO_REF=main
APP_REPO_URL=https://github.com/NF-Hotel/NFHotel.git
APP_REF=main
