# The values of ops/infra/cloudflare/variables.tf for edge-tofu.sh on the machine of S01 or S03
# (ADR-0046 decision 4). Copy this file to edge.env beside it, readable by you only, and fill it
# in; git ignores edge.env:
#   (umask 077 && cp edge.env.example edge.env)
# The wiki page Public-Access ("The edge as code") says where each value is in the dashboard.
# The token is never written here: edge-tofu.sh reads CLOUDFLARE_API_TOKEN, or asks for it.
# docker reads this file with --env-file: one NAME=value per line, no quotes, no spaces around
# the =, and a comment only on a line of its own.

# 32 hexadecimal characters
TF_VAR_account_id=
# The UUID of the tunnel nf-hotel
TF_VAR_tunnel_id=
# The UUID of the Access application NF Hotel back office
TF_VAR_access_application_id=
# The UUID of the Access policy Team
TF_VAR_access_policy_id=
# The team name: the first part of <team>.cloudflareaccess.com
TF_VAR_access_team_name=
# The addresses of the policy Team as a JSON list, such as ["a@example.com","b@example.com"]
TF_VAR_team_emails=
