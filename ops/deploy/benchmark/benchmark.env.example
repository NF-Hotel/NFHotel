# Settings for the benchmark service. Copy to benchmark.env (git-ignored).
# Values are plain text: do not quote them. Never commit benchmark.env.
# Token that the web application must send to this service. The web application gets the same value: scripts/
# deploy-services.sh passes it from this file to the web service, so it is written here only.
# Create with: openssl rand -hex 32
NFBENCH_API_TOKEN=<token-of-at-least-32-characters>
# The NFHotel API on the internal network nfhotel-api. Its service token is the Api__Token of
# nfhotel-api.env; scripts/deploy-services.sh passes it as NFBENCH_WEB_TOKEN, so it is not written here.
NFBENCH_WEB_URL=http://nfhotel-api:8080
# The Ollama of NFHotel on the network nfhotel-llm (deploy/ollama).
NFBENCH_OLLAMA_URL=http://ollama:11434
# Dataset inside the image (synthetic). A real dataset is mounted and named here.
NFBENCH_DATASET=/opt/benchmark/data/example/synthetic_hotel_bookings.csv
# Where results and unsent results are kept (the volume results).
NFBENCH_DATA_DIR=/data
# Names of the Docker networks that NFHotel makes.
NFHOTEL_API_NETWORK=nfhotel-api
NFHOTEL_LLM_NETWORK=nfhotel-llm
# Source repository and the commit it is built from (upgrade by changing the commit).
BENCHMARK_REPO=https://github.com/NF-Hotel/notebook-benchmark.git
BENCHMARK_REF=409693dfd64880f305541ca163877d9bbcfca40d
