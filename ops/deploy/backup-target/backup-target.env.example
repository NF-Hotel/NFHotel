# Settings of the backup target (docker-compose.yml). Copy to backup-target.env
# (git-ignored). Values are plain text: do not quote them.
# The public key of root on nf-hotel: the content of /root/.ssh/nfhotel-backup.pub.
BACKUP_PUBLIC_KEY=ssh-ed25519 AAAA... root@nf-hotel
# The tailnet address of this host (tailscale ip -4); ssh is published there only.
BACKUP_TARGET_BIND=100.64.0.1
BACKUP_TARGET_PORT=2222
# Where the encrypted backups land on this host.
BACKUP_TARGET_DIR=./backups
