# Settings for the market analysis service. Copy to market-analysis.env
# (git-ignored). Values are plain text: do not quote them. No secret is needed.

# Name of the Docker network shared with the nginx service.
NFHOTEL_PROXY_NETWORK=nfhotel-proxy
# Name of the Docker network shared with Ollama.
NFHOTEL_LLM_NETWORK=nfhotel-llm
# Configuration file mounted read-only into both containers (copy
# market-analysis.toml.example to market-analysis.toml first).
MARKET_ANALYSIS_CONFIG=./market-analysis.toml
# Source repository and the commit it is built from (upgrade by changing the commit).
ANALYSIS_REPO=https://github.com/NF-Hotel/Notebook_Market_Analysis.git
ANALYSIS_REF=6c11cbf2a32b7cd2f17b4ebb6384ac458f6b0fb2
