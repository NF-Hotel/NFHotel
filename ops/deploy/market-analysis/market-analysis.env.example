# Settings for the market analysis service (NF-Hotel/notebook-market-analysis). Copy to
# market-analysis.env (git-ignored). Values are plain text: do not quote them.
# Never commit market-analysis.env.

# production requires API_TOKEN and explicit CORS_ALLOWED_ORIGINS.
APP_ENV=production
# The key callers must send in X-API-Key, at least 32 characters. Create with: openssl rand -hex 32.
# The NFHotel web application sends the same value as HolidayApi__ApiKey in nfhotel-web.env
# (scripts/dev-up.sh writes both).
API_TOKEN=change-me
# The web application calls the service from the server, not from a browser; this origin only
# satisfies the production rule and allows nothing else.
CORS_ALLOWED_ORIGINS=https://localhost
LOG_FORMAT=json

# The service serves the holiday calendar for now; it reads no market data.
DATA_SOURCE=csv

# The AI model for the narrative of a run: the Ollama of NFHotel on the network nfhotel-llm
# (deploy/ollama). scripts/deploy-services.sh writes OLLAMA_MODEL from the default AI model chosen in the back
# office (ADR-0014); empty means the run has no AI narrative.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
# A request fails when the model sends nothing for AI_STALL_TIMEOUT_SECONDS, or runs longer than
# AI_TOTAL_TIMEOUT_SECONDS. A CPU-only VM needs minutes for a long answer.
AI_STALL_TIMEOUT_SECONDS=600
AI_TOTAL_TIMEOUT_SECONDS=14400

# Names of the Docker networks shared with nginx, with Ollama and with the web application and API.
NFHOTEL_PROXY_NETWORK=nfhotel-proxy
NFHOTEL_LLM_NETWORK=nfhotel-llm
NFHOTEL_API_NETWORK=nfhotel-api

# Source repository and the commit it is built from (upgrade by changing the commit and the lock file).
MARKET_ANALYSIS_REPO=https://github.com/NF-Hotel/notebook-market-analysis.git
MARKET_ANALYSIS_REF=286889844e9608452ca1971c9f6d69fc7fbabbc7
