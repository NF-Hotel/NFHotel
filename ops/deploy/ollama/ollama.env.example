# Settings for the Ollama service. Copy to ollama.env (git-ignored).
# Values are plain text: do not quote them. No secret is needed.

# Name of the Docker network shared with the benchmark and the analysis service.
NFHOTEL_LLM_NETWORK=nfhotel-llm
# How long a model stays in memory after its last request. The VM has 12 GiB, so
# free the memory soon; use -1 to keep it loaded.
OLLAMA_KEEP_ALIVE=5m
# One model in memory and one request at a time. The benchmark service (notebook-benchmark, ADR-0002
# there) shares this Ollama with the market analysis and measures model by model on the 12 GiB VM.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
# Models pulled by scripts/deploy-services.sh, separated by spaces (empty: none).
# A small model fits the 12 GiB CPU-only VM, for example llama3.2:3b.
OLLAMA_PULL_MODELS=
