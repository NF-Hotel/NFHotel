# Settings of Alloy on nf-hotel (docker-compose.yml, ADR-0020). Copy to alloy.env (git-ignored)
# once the monitoring runs. Values are plain text: do not quote them.
# The monitoring LXC on the tailnet (tailscale ip -4 on the LXC).
PROMETHEUS_REMOTE_WRITE_URL=http://100.64.0.2:9090/api/v1/write
LOKI_PUSH_URL=http://100.64.0.2:3100/loki/api/v1/push
