# Settings of Cloudflare Tunnel (MIL-040, ADR-0028). Copy to cloudflared.env (git-ignored) once the tunnel exists
# in the Cloudflare dashboard; without this file the deploy leaves the tunnel out and the site stays on the tailnet.
# Values are plain text: do not quote them.

# The token of the tunnel, from Zero Trust > Networks > Tunnels > the tunnel > Configure. It is a secret: the
# deploy writes it into a secret file (ADR-0024), never into the environment of the container. Follow the wiki page
# Public-Access to write it here without it reaching the shell history.
TUNNEL_TOKEN=

# Name of the Docker network shared with nginx.
NFHOTEL_PROXY_NETWORK=nfhotel-proxy
