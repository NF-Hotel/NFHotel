# Settings for the NFHotel database API. Copy to nfhotel-api.env (git-ignored).
# Values are plain text: do not quote them. Never commit nfhotel-api.env.
# ASP.NET reads __ as the : separator of configuration keys.

# This file is the production template. scripts/dev-up.sh sets Development from nfhotel-api.env.dev.
ASPNETCORE_ENVIRONMENT=Production
# The database login is not set here: docker-compose.yml builds the connection string
# from deploy/postgres/postgres.env, so the password is written in one file only.
# 32 random bytes, base64. Create with: openssl rand -base64 32
Encryption__PassportKey=<base64-32-bytes>
HotelTime__TimeZoneId=Europe/Copenhagen
# The token that the web application must present, at least 32 characters. Create with:
# openssl rand -base64 32. scripts/deploy-services.sh passes the same value to the
# web service, so it is written here only.
Api__Token=<token-of-at-least-32-characters>

# Staff sign-in for the back office (MIL-016, ADR-0005). These secrets belong to the API only:
# the web application never holds them.
# The key that signs the staff tokens, at least 32 characters. Create with: openssl rand -base64 48
Staff__Token__SigningKey=<signing-key-of-at-least-32-characters>
# The first Manager, created at start when no staff account exists. The password has at least
# 12 characters; create one with: openssl rand -base64 18. The Manager must choose a new password
# at the first sign-in (MustChangePassword, true by default). Once that is done, delete the
# Staff__InitialManager__Password line: it only seeds an empty database and must not stay a
# secret on the server (MIL-030, ADR-0017). Further accounts are made on the Staff page of the
# back office, and a lost Manager password is reset with the reset-staff-password command
# (docs/wiki/Proxmox-Deployment.md).
Staff__InitialManager__UserName=manager
Staff__InitialManager__Password=<password-of-at-least-12-characters>
Staff__InitialManager__MustChangePassword=true
# Apply the pending EF Core migrations when the API starts (the deploy relies on it).
Database__MigrateOnStart=true

# Name of the internal Docker network shared with the web service.
NFHOTEL_API_NETWORK=nfhotel-api
# Name of the internal Docker network shared with PostgreSQL.
NFHOTEL_DB_NETWORK=nfhotel-db

# The market analysis service that analyses the bookings (MIL-026, repository notebook-market-analysis, run API of
# MIL-028). The NFHotel API reaches it by the name market-analysis-api on the internal network nfhotel-api. It starts a run
# with POST /api/v1/market-analysis/runs, follows it with GET .../runs/{id} and reads GET .../runs/{id}/result, so no HTTP
# request stays open while the AI models work. ApiKey is the key of the service, sent as the header X-API-Key (a secret:
# it is never logged and never goes to git; the deploy passes it as a secret file). TimeoutSeconds is the limit of ONE call
# (a few seconds; more than 60 is cut to 60). PollIntervalSeconds is the wait between two asks for the state, and
# RunDeadlineSeconds is how long one run is followed before it is given up (a run with insights takes up to 12 minutes with
# the defaults of the service, longer on a machine without a GPU). An empty address makes the market analysis page say that
# the service is not set up. The address has no built-in default.
MarketAnalysisService__BaseUrl=http://market-analysis-api:8000
MarketAnalysisService__ApiKey=
MarketAnalysisService__TimeoutSeconds=10
MarketAnalysisService__PollIntervalSeconds=5
MarketAnalysisService__RunDeadlineSeconds=3600
