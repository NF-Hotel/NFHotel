# Settings for the NFHotel web service. Copy to nfhotel-web.env (git-ignored).
# Values are plain text: do not quote them. Never commit nfhotel-web.env.
# ASP.NET reads __ as the : separator of configuration keys.

# The Proxmox VM is the development environment (ADR-0003), so the app runs as Development.
ASPNETCORE_ENVIRONMENT=Development
# Trust the X-Forwarded-* headers set by the nginx proxy.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# Redirect a request that arrives as HTTP to HTTPS and always mark the staff cookie Secure (MIL-017).
# The proxy serves TLS, so this is true in the deployment; leave it out for local development.
Tls__Require=true

# The web application holds no database login and no passport key (ADR-0004). It calls the
# database API; docker-compose.yml sets Api__BaseUrl and takes Api__Token from
# deploy/nfhotel-api/nfhotel-api.env, so the token is written in one file only.
# 32 random bytes, base64. Create with: openssl rand -base64 32
Encryption__PassportKey=<base64-32-bytes>
HotelTime__TimeZoneId=Europe/Copenhagen

# NF Hotel Analytics API (holidays). The key is optional.
HolidayApi__BaseUrl=http://market-analysis-api:8000
HolidayApi__TimeoutSeconds=30
HolidayApi__ApiKey=

# The benchmark service that runs the local models (MIL-020, repository notebook-benchmark). It joins the same
# internal network nfhotel-api, so the web application reaches it by the name benchmark. The token is the
# NFBENCH_API_TOKEN of the benchmark service's own env file (openssl rand -hex 32). Leave it empty until the
# service is deployed: the Start page then says the service is not set up. The address has no built-in default.
# The benchmark service delivers its
# results with the Api__Token of nfhotel-api.env, which is its NFBENCH_WEB_TOKEN.
BenchmarkService__BaseUrl=http://benchmark:8000
BenchmarkService__TimeoutSeconds=30
BenchmarkService__Token=

# Name of the Docker network shared with the nginx service.
NFHOTEL_PROXY_NETWORK=nfhotel-proxy
# Name of the internal Docker network shared with the database API.
NFHOTEL_API_NETWORK=nfhotel-api
