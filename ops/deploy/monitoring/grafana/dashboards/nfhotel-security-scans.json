{
  "uid": "nfhotel-security-scans",
  "title": "Security scans",
  "description": "The results of the security scans of the pipeline (MIL-053): GitHub code scanning (CodeQL, Trivy, OWASP ZAP, OpenSSF Scorecard), SonarQube Cloud and the scan workflows, read by the scan exporter every 15 minutes.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "nfhotel",
    "security"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open critical and high findings",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(nfhotel_code_scanning_open_alerts{severity=~\"critical|high|error\"}) or vector(0)",
          "instant": true
        }
      ],
      "description": "Open alerts of GitHub code scanning (CodeQL, Trivy, OWASP ZAP, Scorecard) with severity critical, high or error. Alert ScanFindingsHigh.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "All open findings",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(nfhotel_code_scanning_open_alerts) or vector(0)",
          "instant": true
        }
      ],
      "description": "Every open alert of GitHub code scanning, whatever its severity.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SonarQube Cloud quality gate",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nfhotel_sonar_quality_gate_passed",
          "instant": true
        }
      ],
      "description": "The quality gate of the project NF-Hotel_NFHotel on sonarcloud.io. Alert SonarQualityGateFailed.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "PASSED",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sources read",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nfhotel_scan_source_up",
          "instant": true,
          "legendFormat": "{{source}}"
        }
      ],
      "description": "Whether the scan exporter read each source at its latest try (every 15 minutes). Alert ScanSourceDown.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Open findings by tool and severity",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tool, severity) (nfhotel_code_scanning_open_alerts)",
          "legendFormat": "{{tool}} {{severity}}"
        }
      ],
      "description": "How the open alerts of GitHub code scanning change; a step up after a release or a scan is a new finding.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          },
          "decimals": 0,
          "min": 0,
          "noValue": "No open findings, or no GitHub token (panel Sources read)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Open findings now",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nfhotel_code_scanning_open_alerts",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "The open alerts counted by tool, category and severity.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "Open"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No open findings, or no GitHub token (panel Sources read)"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "SonarQube Cloud measures",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nfhotel_sonar_measure",
          "instant": true,
          "legendFormat": "{{metric}}"
        }
      ],
      "description": "The measures of the project on sonarcloud.io, read every 15 minutes: bugs, vulnerabilities, security hotspots, code smells, coverage (%) and duplicated lines (%).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "coverage|duplicated_lines_density"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Age of the latest analysis",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - nfhotel_code_scanning_last_analysis_timestamp_seconds",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "How long ago each tool and category uploaded an analysis to GitHub code scanning. ZAP, CodeQL and Scorecard run at least weekly (alert ScanStale after 8 days); Trivy of the release images runs with each release.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "red",
                "value": 691200
              }
            ]
          },
          "noValue": "Needs the GitHub token (wiki page Monitoring, Security scans)"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "Age"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Latest run of each scan workflow on main",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nfhotel_scan_workflow_last_run_info",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - nfhotel_scan_workflow_last_run_timestamp_seconds",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "The conclusion and the age of the latest completed run on main of ci.yaml (SonarQube, CodeQL inputs), release.yaml (Trivy), e2e-dast.yaml (OWASP ZAP), running-image-scan.yaml and scorecard.yaml. Alert ScanWorkflowFailed.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "conclusion"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green"
                      },
                      "failure": {
                        "color": "red"
                      },
                      "timed_out": {
                        "color": "red"
                      },
                      "cancelled": {
                        "color": "orange"
                      },
                      "skipped": {
                        "color": "text"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "workflow",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Value #A": true,
              "instance 1": true,
              "instance 2": true,
              "job 1": true,
              "job 2": true,
              "__name__": true
            },
            "renameByName": {
              "Value #B": "Age"
            }
          }
        }
      ]
    }
  ]
}
