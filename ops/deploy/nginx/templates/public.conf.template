# NF Hotel on the public internet (MIL-040, ADR-0028). Cloudflare Tunnel (deploy/cloudflared) forwards the
# requests for the public host name to this listener over the Docker network nfhotel-proxy. Port 8082 is not
# published on the host, so nothing outside the Docker networks reaches it. Cloudflare ends TLS for the
# client; the tunnel itself is encrypted, and this hop stays inside the VM.

server {
  listen 8082;
  server_name _;

  # The client's address, which Cloudflare sends as CF-Connecting-IP, replaces the address of cloudflared, so the
  # per-address sign-in limit of the API and the logs see the guest. It is trusted only from the Docker networks.
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  set_real_ip_from 10.0.0.0/8;
  real_ip_header CF-Connecting-IP;

  # Docker's embedded DNS, as in default.conf.template: the proxy starts while an upstream is down.
  resolver 127.0.0.11 valid=10s;
  set $upstream http://${UPSTREAM_HOST}:${UPSTREAM_PORT};

  # The largest request body (MIL-086 decision 4): the forms of the site send a few kilobytes, and a larger body is
  # answered 413 here, before it reaches an application. The API has the same limit of its own.
  client_max_body_size 64k;

  # How long a slow client may hold a connection (SAR-002, abuse case 11): its header must arrive within 60 seconds,
  # its body may pause 60 seconds between two reads, and an answer it does not read is dropped after 60 seconds. These
  # are the defaults of nginx, named here so that a test holds them; the web application bounds the open circuits of
  # one caller (ADR-0051 decision 8).
  client_header_timeout 60s;
  client_body_timeout 60s;
  send_timeout 60s;

  # The back office (MIL-041, ADR-0029). Cloudflare Access stands in front of /admin, and the first route of the
  # tunnel, path (?i)^/admin, validates its token, so a stranger sees Cloudflare's e-mail page and never the staff
  # sign-in. A request that reaches this listener without the token header (another container on the proxy network,
  # or a route that does not validate) still gets 404. The match ignores letter case, as the routes of the web
  # application do, so /ADMIN gets the same guard (MIL-072).
  location ~* ^/admin {
    if ($http_cf_access_jwt_assertion = "") {
      return 404;
    }
    proxy_pass $upstream;
    include /etc/nginx/snippets/proxy.conf;
  }

  # The two routes of the mobile app (ADR-0015); every other path of /mobile-api/ answers 404.
  include /etc/nginx/snippets/mobile-api.conf;

  # security.txt (RFC 9116, MIL-084, ADR-0048): one file from git, on the public name only, without a sign-in.
  # The application sets the security headers of the site, so this location names its own. Strict-Transport-Security
  # has the value that the application sends for the public site: keep the two equal.
  location = /.well-known/security.txt {
    alias /etc/nginx/well-known/security.txt;
    default_type text/plain;
    charset utf-8;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=2592000" always;
  }

  # The old address at the top level (RFC 9116, section 3): a redirect, so the name is taken and the file exists once.
  location = /security.txt {
    absolute_redirect off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=2592000" always;
    return 301 /.well-known/security.txt;
  }

  # The web socket of the pages, the one location that waits an hour (MIL-086 decision 7).
  include /etc/nginx/snippets/blazor.conf;

  location / {
    proxy_pass $upstream;
    include /etc/nginx/snippets/proxy.conf;
  }
}
