# Settings of the database relay of the team (MIL-048, ADR-0034). Copy to postgres-tailnet.env
# (git-ignored); without this file the deploy leaves the relay out and no port is published.
# Values are plain text: do not quote them. Nothing here is a secret.

# The tailnet address of the VM (tailscale ip -4). The relay publishes 5432 on this address
# only, and the host firewall lets it in from tailscale0 only.
NFHOTEL_TAILNET_IP=100.72.194.127

# Name of the internal Docker network of the database.
NFHOTEL_DB_NETWORK=nfhotel-db
